---
interface Props {
  title: string;
  currentPage?: 'home' | 'contacto';
}

const { title, currentPage = 'home' } = Astro.props;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      main > :first-child { margin-top: 0 !important; }
      main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "tertiary-fixed": "#67fcc6",
            "outline": "#6e7a6f",
            "on-tertiary-fixed-variant": "#00513a",
            "tertiary-fixed-dim": "#44dfab",
            "on-primary-container": "#f6fff4",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "tertiary": "#00694d",
            "on-surface-variant": "#3e4a3f",
            "surface-container-highest": "#dee3ea",
            "on-tertiary-fixed": "#002116",
            "surface-container-low": "#f0f4fb",
            "inverse-primary": "#67dd91",
            "surface-container": "#eaeef5",
            "text-muted": "#6C757D",
            "on-primary": "#ffffff",
            "background": "#f7f9ff",
            "border-subtle": "#E2E8F0",
            "on-error": "#ffffff",
            "error-container": "#ffdad6",
            "inverse-on-surface": "#edf1f8",
            "inverse-surface": "#2c3136",
            "tertiary-container": "#008562",
            "surface-dim": "#d6dae1",
            "on-secondary-container": "#586674",
            "on-surface": "#171c21",
            "secondary-container": "#d5e4f5",
            "on-secondary": "#ffffff",
            "secondary-fixed": "#d5e4f5",
            "on-tertiary-container": "#f5fff7",
            "surface-tint": "#006d3a",
            "surface-alt": "#F4F6F8",
            "on-background": "#171c21",
            "on-secondary-fixed-variant": "#3a4856",
            "secondary-fixed-dim": "#b9c8d9",
            "mint-wash": "#E8F8F0",
            "outline-variant": "#bdcabc",
            "surface": "#f7f9ff",
            "on-error-container": "#93000a",
            "primary": "#006a38",
            "primary-hover": "#047842",
            "on-secondary-fixed": "#0f1d29",
            "surface-bright": "#f7f9ff",
            "surface-dark": "#3A4753",
            "surface-variant": "#dee3ea",
            "on-primary-fixed-variant": "#00522a",
            "primary-container": "#008648",
            "primary-fixed-dim": "#67dd91",
            "surface-container-high": "#e4e8ef",
            "primary-fixed": "#84faab",
            "secondary": "#52606e",
            "on-tertiary": "#ffffff",
            "on-primary-fixed": "#00210d"
          },
          borderRadius: {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          spacing: {
            "gutter": "1.5rem",
            "space-md": "1rem",
            "space-lg": "1.5rem",
            "space-sm": "0.5rem",
            "margin": "1.5rem",
            "space-xl": "2.5rem",
            "space-xs": "0.25rem",
            "margin-lg": "3rem",
            "gutter-sm": "1rem"
          },
          fontFamily: {
            "body-regular": ["Open Sans", "sans-serif"],
            "headline-lg": ["Montserrat", "sans-serif"],
            "body-lead": ["Open Sans", "sans-serif"],
            "body-sm": ["Open Sans", "sans-serif"],
            "headline-hero-mobile": ["Montserrat", "sans-serif"],
            "label-button": ["Montserrat", "sans-serif"],
            "headline-md": ["Montserrat", "sans-serif"],
            "headline-hero": ["Montserrat", "sans-serif"],
            "label-badge": ["Montserrat", "sans-serif"],
            "headline-lg-mobile": ["Montserrat", "sans-serif"],
            "headline-sm": ["Montserrat", "sans-serif"]
          },
          fontSize: {
            "body-regular": ["1rem", { lineHeight: "1.6", fontWeight: "400" }],
            "headline-lg": ["2.25rem", { lineHeight: "1.25", letterSpacing: "-0.01em", fontWeight: "600" }],
            "body-lead": ["1.125rem", { lineHeight: "1.6", fontWeight: "400" }],
            "body-sm": ["0.875rem", { lineHeight: "1.5", fontWeight: "400" }],
            "headline-hero-mobile": ["2.125rem", { lineHeight: "1.25", letterSpacing: "-0.015em", fontWeight: "700" }],
            "label-button": ["1rem", { lineHeight: "1.25", fontWeight: "600" }],
            "headline-md": ["1.35rem", { lineHeight: "1.35", fontWeight: "600" }],
            "headline-hero": ["3rem", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
            "label-badge": ["0.8125rem", { lineHeight: "1.2", letterSpacing: "0.05em", fontWeight: "600" }],
            "headline-lg-mobile": ["1.75rem", { lineHeight: "1.3", fontWeight: "600" }],
            "headline-sm": ["1.125rem", { lineHeight: "1.4", fontWeight: "600" }]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-surface font-body-regular text-body-regular text-on-surface min-h-screen flex flex-col antialiased">
  <header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-md shadow-[0_2px_15px_rgba(26,31,36,0.06)]">
    <div class="h-20 max-w-[1200px] mx-auto px-margin flex items-center justify-between gap-space-md">
      <div class="flex items-center gap-space-md min-w-0">
        <a class="flex items-center gap-space-sm group focus:outline-none" href="/">
          <img alt="Rápido Pack Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBqIoxKTpAuDPuBroM8FlUYxsutM7v9o7WeL-fPVvijmdvxTVryFDi8AXdyOM9j_V8F6GQ5JPPoU1hFQr9u6zAcvQ8BqqQ8ocmDLRwj1H5Mc9auZqwKG9dPW2LT7DAL3JQbjjUT2_ab-qaJaPqAmAr9TWR6yWtC7jLYo3--JCq_taH-uXqV4W9dsu4gmc5uG2Ytxi0BHTFYYS3m_-jzxJqU9CSvZj82nfa2j0-1ukRv" />
          <div class="flex flex-col text-left">
            <span class="font-headline-md text-headline-md leading-none text-on-surface font-bold tracking-tight group-hover:text-primary transition-colors">
              RápidoPack<span class="text-primary">.</span>
            </span>
            <span class="font-body-sm text-body-sm text-secondary font-medium tracking-wide">
              Alfafar · Valencia
            </span>
          </div>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-space-lg">
        {currentPage === 'home' ? (
          <>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="#como-funciona">Cómo Funciona</a>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="#lunes-de-stock">Lunes de Stock</a>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="#ubicacion">Ubicación</a>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="/contacto">Contacto</a>
          </>
        ) : (
          <>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="/">Inicio</a>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="/#lunes-de-stock">Lunes de Stock</a>
            <a class="font-label-button text-label-button text-on-surface-variant hover:text-primary transition-colors" href="/#ubicacion">Ubicación</a>
            <a aria-current="page" class="transition-colors text-primary font-semibold font-label-button text-label-button" href="/contacto">Contacto</a>
          </>
        )}
      </nav>

      <div class="flex items-center gap-space-md">
        <a class="inline-flex items-center justify-center gap-space-xs px-space-md py-space-sm bg-primary hover:bg-primary-hover text-on-primary font-label-button text-label-button rounded-xl transition-all shadow-[0_2px_8px_rgba(0,106,56,0.18)] hover:shadow-[0_4px_12px_rgba(0,106,56,0.28)]" href="https://maps.google.com/?q=Carrer+del+Comte+Ronr%C3%A9e,+8,+46910+Alfafar,+Valencia" rel="noopener noreferrer" target="_blank">
          <span class="material-symbols-outlined text-[18px] leading-none">location_on</span>
          <span>Cómo llegar al local</span>
        </a>
      </div>
    </div>
  </header>

  <main class="w-full pt-20 bg-surface flex-1">
    <slot />
  </main>

  <footer class="w-full bg-surface-dark text-surface-container-lowest">
    <div class="max-w-[1200px] mx-auto px-margin py-margin-lg">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
        <div class="md:col-span-6 flex flex-col gap-space-sm">
          <div class="flex items-center gap-space-sm">
            <span class="font-headline-md text-headline-md text-surface-container-lowest font-bold">
              RápidoPack<span class="text-primary-fixed">.</span>
            </span>
            <span class="font-label-badge text-label-badge text-mint-wash uppercase tracking-wider bg-surface-dark px-space-xs py-space-xs rounded">
              Alfafar · Valencia
            </span>
          </div>
          <p class="font-body-regular text-body-regular text-surface-variant max-w-md">
            Tienda física Outlet de primeras marcas y grandes oportunidades en Valencia. Inspección directa y precios de oportunidad cada semana.
          </p>
        </div>
        <div class="md:col-span-6 flex flex-col md:items-end gap-space-sm text-left md:text-right">
          <div class="flex items-start md:items-center gap-space-xs text-surface-container-lowest font-body-regular text-body-regular">
            <span class="material-symbols-outlined text-primary-fixed text-[20px] shrink-0">storefront</span>
            <span>Carrer del Comte Ronrée, 8, 46910 Alfafar, Valencia</span>
          </div>
          <div class="flex items-center gap-space-xs text-surface-container-lowest font-body-regular text-body-regular">
            <span class="material-symbols-outlined text-primary-fixed text-[20px] shrink-0">call</span>
            <a class="hover:text-primary-fixed transition-colors font-semibold" href="tel:685119511">Tel: 685 11 95 11</a>
          </div>
        </div>
      </div>
      <div class="mt-space-xl pt-space-lg flex flex-col sm:flex-row items-center justify-between gap-space-sm text-surface-variant font-body-sm text-body-sm">
        <p>Copyright Rápido Pack © Todos los derechos reservados.</p>
        <p class="text-surface-variant/80">Grandes oportunidades de Outlet verificadas en Valencia</p>
      </div>
    </div>
  </footer>
</body>
</html>
