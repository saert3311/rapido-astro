---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'paqueteria' | 'outlet' | 'contacto' | 'legal';
  preloadImage?: string;
  socialImage?: string;
}

const {
  title,
  description = SITE.brand.metaDescription,
  currentPage = 'home',
  preloadImage,
  socialImage = '/fachada-rapido-pack-valencia.webp',
} = Astro.props;

const siteBase = Astro.site ? Astro.site.toString() : SITE.brand.canonicalBase;
const canonicalURL = new URL(Astro.url.pathname, siteBase).href;
const socialImageURL = new URL(socialImage, siteBase).href;

const schemaStore = {
  '@context': 'https://schema.org',
  '@type': ['Store', 'LocalBusiness'],
  '@id': `${SITE.brand.canonicalBase}/#store`,
  name: SITE.brand.name,
  legalName: SITE.brand.name,
  url: SITE.brand.canonicalBase,
  logo: `${SITE.brand.canonicalBase}/logo-rapido-pack-valencia.png`,
  image: socialImageURL,
  telephone: `+34${SITE.contact.phoneRaw}`,
  email: SITE.contact.email,
  priceRange: '€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Cash, Credit Card, Mobile Payment',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.location.street,
    addressLocality: SITE.location.city,
    postalCode: SITE.location.postalCode,
    addressRegion: SITE.location.province,
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.location.geo.latitude,
    longitude: SITE.location.geo.longitude,
  },
  hasMap: SITE.location.mapsUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: SITE.schedule.weekdays.open,
      closes: SITE.schedule.weekdays.close,
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: SITE.schedule.saturday.open,
      closes: SITE.schedule.saturday.close,
    },
  ],
  sameAs: [SITE.location.mapsUrl],
};
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/logo-rapido-pack-valencia.png" />
  <title>{title}</title>

  <!-- Google Tag Manager (Production Analytics Container) -->
  <GoogleTagManager />

  <link rel="canonical" href={canonicalURL} />

  <!-- OpenGraph Metadata -->
  <meta property="og:site_name" content={SITE.brand.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:alt" content={SITE.brand.name} />

  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />

  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaStore)} />

  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
  )}
</head>
<body class="bg-surface font-sans text-body-regular text-on-surface min-h-[100svh] flex flex-col antialiased selection:bg-mint-wash selection:text-primary overflow-x-clip">
  <!-- Performance-safe fixed tactile noise layer (Section 5: DOM Cost) -->
  <div
    aria-hidden="true"
    class="fixed inset-0 z-50 pointer-events-none opacity-[0.018]"
    style="background-image: radial-gradient(#111820 0.75px, transparent 0.75px); background-size: 16px 16px;"
  ></div>

  <Header currentPage={currentPage === 'legal' ? undefined : currentPage} />

  <main id="main-content" class="w-full pt-28 sm:pt-32 lg:pt-36 bg-surface flex-1">
    <slot />
  </main>

  <Footer />

  <!-- Persistent Mobile Sticky Bottom CTA -->
  <div class="md:hidden fixed bottom-3 left-3 right-3 z-40">
    <a
      class="w-full flex items-center justify-between px-4 py-3.5 bg-primary hover:bg-primary-hover text-on-primary font-label-button text-sm rounded-xl shadow-xl border border-primary-fixed/30 active:scale-[0.98] transition-transform"
      href={SITE.location.mapsUrl}
      rel="noopener noreferrer"
      target="_blank"
    >
      <span class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">navigation</span>
        <span>Cómo llegar a {SITE.brand.name}</span>
      </span>
      <span class="font-mono text-xs bg-surface-dark/25 px-2.5 py-1 rounded-md">Estación Alfafar · 5 min a pie</span>
    </a>
  </div>
</body>
</html>
