---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'outlet' | 'contacto';
}

const {
  title,
  description = 'Rápido Pack Valencia en Alfafar. Tienda física outlet de primeras marcas, productos de segunda mano verificados con mercancía nueva todas las semanas y punto oficial de paquetería.',
  currentPage = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/logo-rapido-pack-valencia.png" />
  <title>{title}</title>

  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
    rel="stylesheet"
  />
</head>
<body class="bg-surface font-sans text-body-regular text-on-surface min-h-[100svh] flex flex-col antialiased selection:bg-mint-wash selection:text-primary">
  <!-- Performance-safe fixed tactile noise layer (Section 5: DOM Cost) -->
  <div
    aria-hidden="true"
    class="fixed inset-0 z-50 pointer-events-none opacity-[0.018]"
    style="background-image: radial-gradient(#111820 0.75px, transparent 0.75px); background-size: 16px 16px;"
  ></div>

  <Header currentPage={currentPage} />

  <main id="main-content" class="w-full pt-24 bg-surface flex-1">
    <slot />
  </main>

  <Footer />
</body>
</html>
