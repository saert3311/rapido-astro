---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: 'home' | 'contacto';
}

const {
  title,
  description = 'Rápido Pack en Alfafar, Valencia. Tienda física outlet de primeras marcas con reposición cada lunes y punto oficial de paquetería.',
  currentPage = 'home',
} = Astro.props;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <link href="https://fonts.googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />

  <style is:global>
    @layer base {
      html, body {
        margin: 0;
        padding: 0;
      }
      body {
        overscroll-behavior: none;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      @view-transition {
        navigation: auto;
      }
    }

    /* Defer layout and paint of off-screen below-the-fold sections */
    .section-deferred {
      content-visibility: auto;
      contain-intrinsic-size: auto none auto 480px;
    }

    /* Native details summary reset for clean accordions */
    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "tertiary-fixed": "#67fcc6",
            "outline": "#6e7a6f",
            "on-tertiary-fixed-variant": "#00513a",
            "tertiary-fixed-dim": "#44dfab",
            "on-primary-container": "#f6fff4",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "tertiary": "#20C997",
            "on-surface-variant": "#3e4a3f",
            "surface-container-highest": "#dee3ea",
            "on-tertiary-fixed": "#002116",
            "surface-container-low": "#f0f4fb",
            "inverse-primary": "#67dd91",
            "surface-container": "#eaeef5",
            "text-muted": "#5A6570",
            "on-primary": "#ffffff",
            "background": "#f7f9ff",
            "border-subtle": "#E2E8F0",
            "on-error": "#ffffff",
            "error-container": "#ffdad6",
            "inverse-on-surface": "#edf1f8",
            "inverse-surface": "#2c3136",
            "tertiary-container": "#008562",
            "surface-dim": "#d6dae1",
            "on-secondary-container": "#485664",
            "on-surface": "#1A1F24",
            "secondary-container": "#d5e4f5",
            "on-secondary": "#ffffff",
            "secondary-fixed": "#d5e4f5",
            "on-tertiary-container": "#f5fff7",
            "surface-tint": "#059652",
            "surface-alt": "#F4F6F8",
            "on-background": "#1A1F24",
            "on-secondary-fixed-variant": "#3a4856",
            "secondary-fixed-dim": "#b9c8d9",
            "mint-wash": "#E8F8F0",
            "outline-variant": "#bdcabc",
            "surface": "#FFFFFF",
            "on-error-container": "#93000a",
            "primary": "#059652",
            "primary-hover": "#047842",
            "on-secondary-fixed": "#0f1d29",
            "surface-bright": "#f7f9ff",
            "surface-dark": "#2C3640",
            "surface-variant": "#dee3ea",
            "on-primary-fixed-variant": "#00522a",
            "primary-container": "#008648",
            "primary-fixed-dim": "#67dd91",
            "surface-container-high": "#e4e8ef",
            "primary-fixed": "#84faab",
            "secondary": "#485664",
            "on-tertiary": "#ffffff",
            "on-primary-fixed": "#00210d"
          },
          borderRadius: {
            "sm": "0.125rem",
            "DEFAULT": "0.25rem",
            "md": "0.375rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "2xl": "1rem",
            "full": "9999px"
          },
          spacing: {
            "gutter": "1.5rem",
            "space-md": "1rem",
            "space-lg": "1.5rem",
            "space-sm": "0.5rem",
            "margin": "1.5rem",
            "space-xl": "2.5rem",
            "space-xs": "0.25rem",
            "margin-lg": "3.5rem",
            "gutter-sm": "1rem"
          },
          fontFamily: {
            "body-regular": ["Open Sans", "sans-serif"],
            "headline-lg": ["Montserrat", "sans-serif"],
            "body-lead": ["Open Sans", "sans-serif"],
            "body-sm": ["Open Sans", "sans-serif"],
            "headline-hero-mobile": ["Montserrat", "sans-serif"],
            "label-button": ["Montserrat", "sans-serif"],
            "headline-md": ["Montserrat", "sans-serif"],
            "headline-hero": ["Montserrat", "sans-serif"],
            "label-badge": ["Montserrat", "sans-serif"],
            "headline-lg-mobile": ["Montserrat", "sans-serif"],
            "headline-sm": ["Montserrat", "sans-serif"]
          },
          fontSize: {
            "body-regular": ["1rem", { lineHeight: "1.6", fontWeight: "400" }],
            "headline-lg": ["2.125rem", { lineHeight: "1.25", letterSpacing: "-0.015em", fontWeight: "700" }],
            "body-lead": ["1.125rem", { lineHeight: "1.6", fontWeight: "400" }],
            "body-sm": ["0.875rem", { lineHeight: "1.5", fontWeight: "400" }],
            "headline-hero-mobile": ["2rem", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "700" }],
            "label-button": ["0.9375rem", { lineHeight: "1.25", fontWeight: "600" }],
            "headline-md": ["1.25rem", { lineHeight: "1.35", fontWeight: "600" }],
            "headline-hero": ["2.875rem", { lineHeight: "1.15", letterSpacing: "-0.025em", fontWeight: "700" }],
            "label-badge": ["0.75rem", { lineHeight: "1.2", letterSpacing: "0.06em", fontWeight: "600" }],
            "headline-lg-mobile": ["1.625rem", { lineHeight: "1.3", fontWeight: "700" }],
            "headline-sm": ["1.0625rem", { lineHeight: "1.4", fontWeight: "600" }]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-surface font-body-regular text-body-regular text-on-surface min-h-screen flex flex-col antialiased selection:bg-mint-wash selection:text-primary">
  <Header currentPage={currentPage} />

  <main id="main-content" class="w-full pt-20 bg-surface flex-1">
    <slot />
  </main>

  <Footer />
</body>
</html>
