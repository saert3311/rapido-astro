---
interface Props {
  carrier: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { carrier, size = 'md', class: className = '' } = Astro.props;

const normalizedCarrier = carrier.trim().toUpperCase();

// Per-carrier optical height calibration so wide marks (SEUR) and tall marks (InPost) look balanced and never hit a max-width clip
const carrierSizeClasses: Record<string, Record<'sm' | 'md' | 'lg', string>> = {
  INPOST: {
    sm: 'h-5 w-auto',
    md: 'h-7 sm:h-8 w-auto',
    lg: 'h-9 sm:h-10 w-auto',
  },
  GLS: {
    sm: 'h-4 w-auto',
    md: 'h-5 sm:h-6 w-auto',
    lg: 'h-7 sm:h-8 w-auto',
  },
  SEUR: {
    sm: 'h-3.5 w-auto',
    md: 'h-4 sm:h-[19px] w-auto',
    lg: 'h-6 sm:h-7 w-auto',
  },
  KANGURO: {
    sm: 'h-4 w-auto',
    md: 'h-5 sm:h-6 w-auto',
    lg: 'h-7 sm:h-8 w-auto',
  },
};

const currentSizeClass =
  carrierSizeClasses[normalizedCarrier]?.[size] || 'h-6 w-auto';
