---
interface Props {
  carrier: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { carrier, size = 'md', class: className = '' } = Astro.props;

const normalizedCarrier = carrier.trim().toUpperCase();

// Size mappings for consistent visual balance
const sizeClasses = {
  sm: 'h-4 w-auto max-w-[80px]',
  md: 'h-7 w-auto max-w-[120px]',
  lg: 'h-9 w-auto max-w-[150px]',
};

const currentSizeClass = sizeClasses[size] || sizeClasses.md;
---

<div class:list={['inline-flex items-center justify-center select-none', className]}>
  {normalizedCarrier === 'INPOST' && (
    <svg
      aria-hidden="true"
      viewBox="0 0 110 32"
      class:list={[
        currentSizeClass,
        'transition-all duration-300 ease-out filter grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105',
      ]}
    >
      <!-- InPost Yellow rounded pill -->
      <rect x="1" y="2" width="108" height="28" rx="6" fill="#FFD100" />
      <!-- InPost bold typography with signature dot -->
      <text
        x="55"
        y="21"
        fill="#111820"
        font-family="Outfit, Plus Jakarta Sans, sans-serif"
        font-size="16"
        font-weight="900"
        letter-spacing="-0.5"
        text-anchor="middle"
      >
        InPost
      </text>
      <circle cx="87" cy="11" r="2.5" fill="#E2007A" />
    </svg>
  )}

  {normalizedCarrier === 'GLS' && (
    <svg
      aria-hidden="true"
      viewBox="0 0 96 32"
      class:list={[
        currentSizeClass,
        'transition-all duration-300 ease-out filter grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105',
      ]}
    >
      <!-- GLS Deep Blue rounded badge -->
      <rect x="1" y="2" width="94" height="28" rx="6" fill="#002B7F" />
      <!-- GLS White Italic Bold letters -->
      <text
        x="42"
        y="21"
        fill="#FFFFFF"
        font-family="Outfit, Plus Jakarta Sans, sans-serif"
        font-size="17"
        font-weight="900"
        font-style="italic"
        letter-spacing="0.5"
        text-anchor="middle"
      >
        GLS
      </text>
      <!-- GLS Signature Yellow Swoosh Arrow -->
      <path
        d="M68 18 C74 18, 80 14, 84 9 C82 14, 76 22, 67 22 Z"
        fill="#FFE500"
      />
    </svg>
  )}

  {normalizedCarrier === 'SEUR' && (
    <svg
      aria-hidden="true"
      viewBox="0 0 100 32"
      class:list={[
        currentSizeClass,
        'transition-all duration-300 ease-out filter grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105',
      ]}
    >
      <!-- SEUR Crisp White container with border -->
      <rect x="1" y="2" width="98" height="28" rx="6" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1.5" />
      <!-- SEUR Characteristic Red Italic Typography -->
      <text
        x="50"
        y="21"
        fill="#E30613"
        font-family="Outfit, Plus Jakarta Sans, sans-serif"
        font-size="17"
        font-weight="900"
        font-style="italic"
        letter-spacing="-0.5"
        text-anchor="middle"
      >
        SEUR
      </text>
    </svg>
  )}

  {normalizedCarrier === 'KANGURO' && (
    <svg
      aria-hidden="true"
      viewBox="0 0 120 32"
      class:list={[
        currentSizeClass,
        'transition-all duration-300 ease-out filter grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105',
      ]}
    >
      <!-- Kanguro Soft Warm Container -->
      <rect x="1" y="2" width="118" height="28" rx="6" fill="#FFF7ED" stroke="#FED7AA" stroke-width="1.5" />
      <!-- Kanguro Orange Emblem Icon -->
      <circle cx="20" cy="16" r="8" fill="#FF4600" />
      <path
        d="M17 12 L24 16 L17 20 Z"
        fill="#FFFFFF"
      />
      <!-- Kanguro Text -->
      <text
        x="68"
        y="21"
        fill="#1E293B"
        font-family="Outfit, Plus Jakarta Sans, sans-serif"
        font-size="14"
        font-weight="800"
        letter-spacing="0.5"
        text-anchor="middle"
      >
        KANGURO
      </text>
    </svg>
  )}
</div>
