---
interface Props {
  carrier: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { carrier, size = 'md', class: className = '' } = Astro.props;

const normalizedCarrier = carrier.trim().toUpperCase();

// Size mappings for consistent visual balance across carrier shapes
const sizeClasses = {
  sm: 'h-4 w-auto max-w-[85px]',
  md: 'h-6 sm:h-7 w-auto max-w-[125px]',
  lg: 'h-8 sm:h-9 w-auto max-w-[160px]',
};

const currentSizeClass = sizeClasses[size] || sizeClasses.md;
