---
interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
}

const {
  badge = 'Visita Directa',
  title = 'Ubicación y Horarios del Local',
  subtitle = 'Estamos en el corazón comercial de Alfafar. Fácil aparcamiento gratuito y acceso directo por la V-31 desde Valencia capital.',
} = Astro.props;
---

<section class="w-full bg-surface-alt py-margin-lg section-deferred" id="ubicacion">
  <div class="max-w-[1200px] mx-auto px-margin">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
      <div class="max-w-2xl">
        <span class="inline-block font-label-badge text-label-badge text-primary uppercase tracking-widest bg-mint-wash px-3 py-1 rounded">
          {badge}
        </span>
        <h2 class="mt-2 font-headline-lg text-headline-lg-mobile md:text-headline-lg text-surface-dark">
          {title}
        </h2>
        <p class="font-body-regular text-body-regular text-text-muted mt-2">
          {subtitle}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-lowest border border-border-subtle rounded-md font-body-sm text-xs text-surface-dark font-medium">
          <span class="material-symbols-outlined text-primary text-[16px]" aria-hidden="true">directions_car</span>
          8 min desde Valencia (V-31)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-lowest border border-border-subtle rounded-md font-body-sm text-xs text-surface-dark font-medium">
          <span class="material-symbols-outlined text-primary text-[16px]" aria-hidden="true">local_parking</span>
          Aparcamiento libre en puerta
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-stretch">
      <!-- Left Column: Store Details & Schedule (5 Cols) -->
      <div class="lg:col-span-5 bg-surface-container-lowest rounded-lg p-space-lg sm:p-space-xl border border-border-subtle border-l-4 border-l-primary flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-space-sm mb-space-md">
            <div>
              <span class="font-label-badge text-xs font-semibold text-primary uppercase tracking-wider">
                Tienda Física Oficial
              </span>
              <h3 class="font-headline-md text-headline-md text-surface-dark mt-0.5">
                Rápido Pack Valencia
              </h3>
            </div>
            <div class="inline-flex items-center gap-1 bg-mint-wash px-2.5 py-1 rounded text-primary font-label-badge text-xs shrink-0">
              <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
              <span>5.0 Google</span>
            </div>
          </div>

          <address class="not-italic p-space-md rounded-md bg-surface-alt border border-border-subtle mb-space-md flex items-start gap-space-sm">
            <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5" aria-hidden="true">location_on</span>
            <div>
              <p class="font-headline-sm text-sm text-surface-dark font-semibold">Carrer del Comte Ronrée, 8</p>
              <p class="font-body-sm text-xs text-text-muted mt-0.5">46910 Alfafar, Valencia (Comunidad Valenciana)</p>
            </div>
          </address>

          <div class="space-y-1.5 mb-space-lg">
            <p class="font-label-badge text-xs uppercase tracking-wider text-surface-dark font-bold mb-2">
              Horario Semanal Ininterrumpido
            </p>
            <div class="flex items-center justify-between px-3 py-2.5 rounded-md bg-mint-wash text-primary font-semibold text-sm border border-primary/20">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">inventory_2</span>
                <span>Lunes (Reposición Total)</span>
              </div>
              <span class="tabular-nums">09:30 – 20:00</span>
            </div>
            <div class="flex items-center justify-between px-3 py-2 rounded-md bg-surface-alt text-surface-dark font-body-sm text-sm">
              <span>Martes a Viernes</span>
              <span class="font-semibold tabular-nums">09:30 – 20:00</span>
            </div>
            <div class="flex items-center justify-between px-3 py-2 rounded-md bg-surface-alt text-surface-dark font-body-sm text-sm">
              <span>Sábados</span>
              <span class="font-semibold tabular-nums">10:00 – 15:00</span>
            </div>
            <div class="flex items-center justify-between px-3 py-2 rounded-md bg-surface-alt text-text-muted font-body-sm text-sm">
              <span>Domingos</span>
              <span class="font-semibold text-error">Cerrado</span>
            </div>
          </div>

          <div class="mb-space-lg">
            <a
              class="flex items-center gap-space-sm p-3 rounded-md bg-surface-alt border border-border-subtle hover:border-primary/40 transition-colors group"
              href="tel:685119511"
            >
              <div class="w-10 h-10 rounded-md bg-mint-wash flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">phone_in_talk</span>
              </div>
              <div>
                <p class="font-body-sm text-xs text-text-muted">Atención telefónica en tienda</p>
                <p class="font-headline-sm text-base text-surface-dark font-bold group-hover:text-primary transition-colors tabular-nums">
                  685 11 95 11
                </p>
              </div>
            </a>
          </div>
        </div>

        <a
          class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-space-lg bg-primary hover:bg-primary-hover text-on-primary font-label-button text-sm rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          href="https://www.google.com/maps/place//data=!4m2!3m1!19sChIJw5ZDyrhPYA0RASxZojeQoD0"
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">directions</span>
          <span>Abrir Ruta en Google Maps</span>
        </a>
      </div>

      <!-- Right Column: Map Hub (7 Cols) -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-lg p-2 border border-border-subtle flex flex-col justify-between relative min-h-[440px]">
        <div class="w-full h-full min-h-[420px] rounded-md relative overflow-hidden bg-surface-container flex flex-col justify-between p-space-md">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDHcHHryPs96Yr_U5zIZHCmdfyw-btQQmxlW1_DLl9r-BeINGVl6YDjbmTATQrEhG2p-IVbTp6nzC6tw4ZtL2HMHMpp1LHn5Y9Z0KxbSMgu9vaAxi3J1Rbbk23ucMUr-pgzwYfKpN0xfaK4SBIWTWSUns5l-1ejbTu1tE-06wft09dNKYuzFokUcyk6hdsch4Jke3m3bbwe34igSez6hmplWbU_KGUrPxtCy8CTPwCk"
            alt="Mapa de situación de Rápido Pack en Carrer del Comte Ronrée 8, Alfafar"
            loading="lazy"
            decoding="async"
            width="700"
            height="460"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-surface-dark/10 pointer-events-none"></div>

          <!-- Top Bar -->
          <div class="relative z-10 flex items-center justify-between gap-2">
            <div class="bg-surface-dark/90 backdrop-blur-sm px-3.5 py-2 rounded-md flex items-center gap-2.5 text-on-primary">
              <span class="material-symbols-outlined text-primary-fixed text-[20px]" aria-hidden="true">pin_drop</span>
              <div>
                <p class="font-headline-sm text-xs leading-none font-bold">Alfafar, Valencia</p>
                <p class="font-body-sm text-xs text-surface-variant mt-0.5">Carrer del Comte Ronrée, 8</p>
              </div>
            </div>
            <div class="hidden sm:flex items-center gap-1.5 bg-surface-dark/90 backdrop-blur-sm px-3 py-1.5 rounded-md text-on-primary font-body-sm text-xs">
              <span class="material-symbols-outlined text-[16px] text-primary-fixed" aria-hidden="true">train</span>
              <span>Renfe Alfafar-Benetússer a 10 min</span>
            </div>
          </div>

          <!-- Center Marker -->
          <div class="relative z-10 my-auto mx-auto flex flex-col items-center pointer-events-none">
            <div class="bg-surface-dark text-on-primary font-label-badge text-xs px-3 py-1.5 rounded-md mb-1.5 shadow-md flex items-center gap-1.5 border border-primary-fixed/30">
              <span>Rápido Pack</span>
              <span class="material-symbols-outlined text-primary-fixed text-[14px]" aria-hidden="true">verified</span>
            </div>
            <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg ring-4 ring-surface-container-lowest">
              <span class="material-symbols-outlined text-[20px]" aria-hidden="true">storefront</span>
            </div>
          </div>

          <!-- Bottom Action Bar -->
          <div class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-space-sm bg-surface-container-lowest/95 backdrop-blur-sm p-3 rounded-md border border-border-subtle">
            <div class="flex items-center gap-2 text-surface-dark text-xs font-medium">
              <span class="material-symbols-outlined text-primary text-[18px]" aria-hidden="true">navigation</span>
              <span>Acceso directo desde V-31 (Pista de Silla)</span>
            </div>
            <a
              class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3.5 py-2 bg-surface-dark hover:bg-secondary text-on-primary font-label-badge text-xs uppercase tracking-wider rounded transition-colors"
              href="https://www.google.com/maps/place//data=!4m2!3m1!19sChIJw5ZDyrhPYA0RASxZojeQoD0"
              rel="noopener noreferrer"
              target="_blank"
            >
              <span>Ver en Google Maps</span>
              <span class="material-symbols-outlined text-[15px]" aria-hidden="true">open_in_new</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
