---
import { SITE } from '../config/site';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
}

const {
  badge = '02 // Acceso y Horario',
  title = `Visita ${SITE.brand.name} en Alfafar`,
  subtitle = `${SITE.location.stationNote}.`,
} = Astro.props;
---

<section class="w-full bg-surface-alt py-16 lg:py-24 scroll-mt-28 sm:scroll-mt-32 lg:scroll-mt-36" id="ubicacion">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10">
      <span class="inline-block font-mono text-xs font-semibold text-primary uppercase tracking-widest mb-2">
        {badge}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-surface-dark">
        {title}
      </h2>
      <p class="font-sans text-base text-text-muted mt-2 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Left Column: Store Details & Schedule (5 Cols) -->
      <div class="lg:col-span-5 bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-border-subtle diffusion-card flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-4 pb-5 border-b border-border-subtle">
            <div>
              <span class="font-mono text-xs font-semibold text-primary uppercase tracking-wider">
                Tienda Física &amp; Paquetería
              </span>
              <h3 class="font-display text-2xl font-bold text-surface-dark mt-1">
                {SITE.brand.name}
              </h3>
            </div>
            <div class="inline-flex items-center gap-1.5 bg-mint-wash px-3 py-1.5 rounded-full text-primary font-mono text-xs font-semibold shrink-0">
              <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
              <span>5.0</span>
            </div>
          </div>

          <address class="not-italic py-5 border-b border-border-subtle flex flex-col gap-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">location_on</span>
                <div>
                  <p class="font-display text-base text-surface-dark font-bold">{SITE.location.street}</p>
                  <p class="font-mono text-xs text-text-muted mt-0.5">{SITE.location.postalCode} {SITE.location.city} · {SITE.location.province}</p>
                </div>
              </div>
              <a
                href={SITE.contact.phoneHref}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-alt hover:bg-mint-wash text-surface-dark hover:text-primary font-mono text-xs font-semibold transition-colors shrink-0"
              >
                <span class="material-symbols-outlined text-[15px] text-primary" aria-hidden="true">call</span>
                <span>{SITE.contact.phoneDisplay}</span>
              </a>
            </div>
            <div class="flex items-center gap-2 text-xs font-sans text-secondary">
              <span class="material-symbols-outlined text-primary text-[17px] shrink-0" aria-hidden="true">train</span>
              <span>{SITE.location.stationNote}</span>
            </div>
          </address>

          <!-- De-Boxed Schedule Ledger with Monospace Time Slots -->
          <div class="py-5">
            <p class="font-mono text-xs uppercase tracking-wider text-text-muted font-semibold mb-3">
              Horario Comercial Ininterrumpido
            </p>

            <div class="divide-y divide-border-subtle border-t border-b border-border-subtle">
              <div class="flex items-center justify-between py-3 px-2 rounded-sm bg-mint-wash/50 text-surface-dark text-sm">
                <div class="flex items-center gap-2 font-semibold text-primary">
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">storefront</span>
                  <span>Lunes a Viernes</span>
                </div>
                <span class="font-mono font-semibold text-primary tabular-nums">{SITE.schedule.weekdays.label}</span>
              </div>
              <div class="flex items-center justify-between py-3 px-2 text-surface-dark text-sm">
                <span class="font-medium">Sábados</span>
                <span class="font-mono font-semibold tabular-nums">{SITE.schedule.saturday.label}</span>
              </div>
              <div class="flex items-center justify-between py-3 px-2 text-text-muted text-sm">
                <span>Domingos</span>
                <span class="font-mono font-semibold text-error">{SITE.schedule.sunday.label}</span>
              </div>
            </div>
          </div>
        </div>

        <a
          class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 bg-primary hover:bg-primary-hover text-on-primary font-label-button text-sm rounded-xl transition-all active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          href={SITE.location.mapsUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">directions</span>
          <span>Abrir Ruta en Google Maps</span>
        </a>
      </div>

      <!-- Right Column: Native Lazy-Loaded Interactive Map (7 Cols) -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-3xl p-2.5 border border-border-subtle diffusion-card flex flex-col min-h-[420px]">
        <div
          id="map-container"
          class="w-full h-full min-h-[420px] rounded-2xl overflow-hidden bg-surface-alt border border-border-subtle/70 flex flex-col"
        >
          <iframe
            src={SITE.location.mapsEmbedUrl}
            title={`Mapa interactivo de ${SITE.brand.name} en ${SITE.location.fullAddress}`}
            class="w-full flex-1 min-h-[420px] border-0 block"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
