---
import { SITE } from '../config/site';

interface Props {
  gtmId?: string;
  id?: string;
  forceEnable?: boolean;
}

const { gtmId, id, forceEnable = false } = Astro.props;

// Parameterized container ID with trim and format sanitization
const rawId = (gtmId || id || SITE.analytics.gtmId || '').trim();
const isValidId = /^[A-Z0-9-]+$/i.test(rawId);

// Render strictly in production builds unless explicitly enabled via prop or environment flag
const shouldRender =
  isValidId &&
  (forceEnable || import.meta.env.PROD || import.meta.env.PUBLIC_GTM_FORCE === 'true');
---

{shouldRender && (
  <>
    <!-- Google Tag Manager Resource Hints (non-CORS preconnect matching classic script fetch) -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google Tag Manager Data Layer, Consent Mode v2 & Event Initialization (Must precede async gtm.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Google Consent Mode v2: Read stored consent or default to denied
      var storedConsent = null;
      try {
        storedConsent = JSON.parse(localStorage.getItem('rpv_cookie_consent') || 'null');
      } catch(e) {}

      var isAnalyticsGranted = storedConsent && storedConsent.analytics === true;

      gtag('consent', 'default', {
        'analytics_storage': isAnalyticsGranted ? 'granted' : 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      window.dataLayer.push({
        'gtm.start': new Date().getTime(),
        event: 'gtm.js'
      });
      gtag('js', new Date());
    </script>

    <!-- Google Tag Manager Container Script -->
    <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(rawId)}`}></script>
  </>
)}
