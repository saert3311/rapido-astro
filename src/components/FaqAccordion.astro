---
import { SITE } from '../config/site';

export interface FaqItem {
  question: string;
  answer: string;
  icon?: string;
}

interface Props {
  badge: string;
  title: string;
  subtitle: string;
  items: FaqItem[];
  groupName?: string;
}

const { badge, title, subtitle, items, groupName = 'faq-accordion' } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <!-- Left Column: Asymmetric Editorial Header (5 Cols) -->
    <div class="lg:col-span-5 text-left">
      <span class="inline-block font-mono text-xs font-semibold text-primary uppercase tracking-widest mb-2">
        {badge}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-surface-dark">
        {title}
      </h2>
      <p class="font-sans text-base text-text-muted mt-3 leading-relaxed">
        {subtitle}
      </p>
      <div class="mt-6 pt-6 border-t border-border-subtle flex items-center gap-3 text-sm text-secondary">
        <span class="w-9 h-9 rounded-lg bg-mint-wash text-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">support_agent</span>
        </span>
        <span>
          ¿Necesitas atención inmediata? Llámanos al <a href={SITE.contact.phoneHref} class="font-mono font-semibold text-surface-dark underline hover:text-primary">{SITE.contact.phoneDisplay}</a>.
        </span>
      </div>
    </div>

    <!-- Right Column: Hairline Accordion List (7 Cols) -->
    <div class="lg:col-span-7 divide-y divide-border-subtle border-t border-b border-border-subtle">
      {items.map((item, idx) => (
        <details
          name={groupName}
          open={idx === 0}
          class="group bg-surface-container-lowest transition-colors"
        >
          <summary class="flex items-center justify-between gap-4 py-5 px-2 cursor-pointer list-none select-none font-display text-lg font-bold text-surface-dark hover:text-primary group-open:text-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary">
            <span class="flex items-center gap-3.5 text-left">
              {item.icon && (
                <span class="w-9 h-9 rounded-lg bg-surface-alt group-open:bg-mint-wash text-primary flex items-center justify-center shrink-0 transition-colors">
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">{item.icon}</span>
                </span>
              )}
              <span>{item.question}</span>
            </span>
            <span
              class="material-symbols-outlined text-[22px] text-text-muted group-open:text-primary group-open:rotate-180 transition-transform duration-200 shrink-0"
              aria-hidden="true"
            >
              expand_more
            </span>
          </summary>
          <div class="px-2 pb-6 pt-1 pl-14 font-sans text-sm sm:text-base text-text-muted leading-relaxed">
            <p set:html={item.answer} />
          </div>
        </details>
      ))}
    </div>
  </div>
</div>
