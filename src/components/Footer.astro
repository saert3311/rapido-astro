---
import { SITE } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-surface-dark text-surface-container-lowest border-t border-white/10 pb-24 md:pb-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-5 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <a
            href="/"
            class="inline-flex items-center bg-white px-3.5 py-2 rounded-xl border border-white/20 shadow-sm"
            aria-label={`${SITE.brand.name} — Inicio`}
          >
            <img
              src="/logo-rapido-pack-valencia.png"
              alt={SITE.brand.name}
              width="140"
              height="98"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="flex flex-col">
            <span class="font-display text-lg text-white font-bold tracking-tight">
              {SITE.brand.name}
            </span>
            <span class="font-mono text-[11px] text-primary-fixed uppercase tracking-wider mt-0.5">
              {SITE.location.city} · {SITE.location.province}
            </span>
          </div>
        </div>
        <p class="font-sans text-sm text-surface-variant max-w-sm leading-relaxed">
          Tienda física Outlet de primeras marcas, artículos de segunda mano revisados y punto oficial de paquetería en Valencia, en convivencia con nuestra próxima tienda web. Inspección directa en mesas con enchufe y mercancía nueva todas las semanas.
        </p>
      </div>

      <div class="md:col-span-3 flex flex-col gap-2">
        <span class="font-mono text-xs uppercase tracking-wider text-primary-fixed mb-1 font-semibold">
          Navegación
        </span>
        <ul class="space-y-2 font-sans text-sm text-surface-variant">
          <li><a class="hover:text-white transition-colors" href="/">Inicio</a></li>
          <li><a class="hover:text-white transition-colors" href="/paqueteria">Paquetería</a></li>
          <li><a class="hover:text-white transition-colors" href="/outlet">Outlet</a></li>
          <li><a class="hover:text-white transition-colors" href="/contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="md:col-span-4 flex flex-col gap-2">
        <span class="font-mono text-xs uppercase tracking-wider text-primary-fixed mb-1 font-semibold">
          {SITE.brand.name}
        </span>
        <address class="not-italic flex flex-col gap-2.5 text-sm text-white">
          <div class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-primary-fixed text-[18px] shrink-0 mt-0.5" aria-hidden="true">location_on</span>
            <a class="hover:text-primary-fixed transition-colors" href={SITE.location.mapsUrl} target="_blank" rel="noopener noreferrer">
              {SITE.location.fullAddress}
            </a>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-primary-fixed text-[18px] shrink-0" aria-hidden="true">call</span>
            <a class="hover:text-primary-fixed transition-colors font-mono font-semibold tabular-nums" href={SITE.contact.phoneHref}>{SITE.contact.phoneDisplay}</a>
          </div>
          <div class="flex items-center gap-2.5 text-surface-variant font-mono text-xs">
            <span class="material-symbols-outlined text-primary-fixed text-[18px] shrink-0" aria-hidden="true">schedule</span>
            <span>{SITE.schedule.summaryBadge}</span>
          </div>
        </address>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-surface-variant font-mono text-xs">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-6 text-center sm:text-left">
        <p>© {currentYear} {SITE.brand.name}. Todos los derechos reservados.</p>
        <div class="flex items-center gap-3 flex-wrap justify-center sm:justify-start">
          <a class="hover:text-white transition-colors underline decoration-white/20 underline-offset-4" href="/aviso-legal">Aviso Legal</a>
          <span class="text-white/25" aria-hidden="true">·</span>
          <a class="hover:text-white transition-colors underline decoration-white/20 underline-offset-4" href="/privacidad">Privacidad</a>
          <span class="text-white/25" aria-hidden="true">·</span>
          <a class="hover:text-white transition-colors underline decoration-white/20 underline-offset-4" href="/cookies">Cookies</a>
          <span class="text-white/25" aria-hidden="true">·</span>
          <button
            type="button"
            id="footer-cookie-settings-btn"
            class="hover:text-white transition-colors underline decoration-white/20 underline-offset-4 cursor-pointer text-left font-mono"
          >
            Configurar cookies
          </button>
        </div>
      </div>
      <p class="text-surface-variant/80">Tienda Física y futura Tienda Web · Outlet, Segunda Mano y Paquetería</p>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-cookie-settings-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('rpv:open-cookie-settings'));
  });
</script>
