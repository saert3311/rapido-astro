---
import { SITE } from '../config/site';

const turnstileSiteKey = SITE.security?.turnstileSiteKey || '0x4AAAAAAFWf9LvYLm41PcPy';
---

<!-- External Turnstile API with explicit rendering for strict lifecycle control -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<div class="bg-surface-container-lowest p-6 sm:p-9 rounded-3xl border border-border-subtle diffusion-card">
  <div class="flex flex-col gap-1.5 mb-7 pb-5 border-b border-border-subtle">
    <span class="font-mono text-xs text-primary uppercase tracking-wider font-semibold">
      01 // Atención Directa
    </span>
    <h2 class="font-display text-2xl sm:text-3xl font-bold text-on-surface tracking-tight">
      Envíanos tu consulta
    </h2>
    <p class="font-sans text-sm text-text-muted">
      Escríbenos sobre artículos de segunda mano y outlet, entrada de mercancía semanal o punto de paquetería. Los campos con <span class="text-primary font-semibold">*</span> son obligatorios.
    </p>
  </div>

  <form class="flex flex-col gap-5" id="contact-form" novalidate>
    <!-- Row 1: Nombre completo & Motivo de la consulta (Cuadrícula 2x2 ergonómica) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <!-- Full Name -->
      <div class="field flex flex-col gap-1.5">
        <label class="font-label-button text-sm text-on-surface" for="contact-name">
          Nombre completo <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <span id="name-hint" class="text-xs text-text-muted">
          Indica tu nombre o razón social
        </span>
        <input
          class="form-control w-full px-4 py-3 bg-surface-alt/50 focus:bg-surface-container-lowest text-on-surface border border-border-subtle placeholder:text-text-muted/60 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-sans text-sm"
          id="contact-name"
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          placeholder="Ej. Valeria Serrano"
          aria-describedby="name-hint"
          aria-errormessage="name-error"
        />
        <div id="name-error" class="error-msg text-xs text-error font-medium items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
          <span>Por favor, introduce tu nombre completo (mínimo 2 caracteres).</span>
        </div>
      </div>

      <!-- Subject Select -->
      <div class="field flex flex-col gap-1.5">
        <label class="font-label-button text-sm text-on-surface" for="contact-subject">
          Motivo de la consulta <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <span id="subject-hint" class="text-xs text-text-muted">
          Selecciona el área correspondiente
        </span>
        <div class="relative">
          <select
            class="form-control w-full appearance-none px-4 py-3 bg-surface-alt/50 focus:bg-surface-container-lowest text-on-surface border border-border-subtle rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-sans text-sm pr-10 cursor-pointer"
            id="contact-subject"
            name="subject"
            required
            aria-describedby="subject-hint"
            aria-errormessage="subject-error"
          >
            <option disabled selected value="">Selecciona una opción</option>
            <option value="lotes">Productos de segunda mano, outlet y lotes semanales</option>
            <option value="paqueteria">Paquetería y recogidas (INPOST, GLS, SEUR, KANGURO)</option>
            <option value="horarios">Horarios y ubicación del local</option>
            <option value="otro">Otra consulta</option>
          </select>
          <span class="material-symbols-outlined text-[20px] text-secondary absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
            expand_more
          </span>
        </div>
        <div id="subject-error" class="error-msg text-xs text-error font-medium items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
          <span>Selecciona un motivo para tu consulta.</span>
        </div>
      </div>
    </div>

    <!-- Row 2: Teléfono & Correo electrónico -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="field flex flex-col gap-1.5">
        <label class="font-label-button text-sm text-on-surface" for="contact-phone">
          Teléfono de contacto <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <span id="phone-hint" class="text-xs text-text-muted">
          9 dígitos (ej. {SITE.contact.phoneDisplay})
        </span>
        <input
          class="form-control w-full px-4 py-3 bg-surface-alt/50 focus:bg-surface-container-lowest text-on-surface border border-border-subtle placeholder:text-text-muted/60 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-mono text-sm tabular-nums"
          id="contact-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          required
          pattern="[0-9 \-\+\(\)]{9,20}"
          autocomplete="tel"
          placeholder={SITE.contact.phoneDisplay}
          aria-describedby="phone-hint"
          aria-errormessage="phone-error"
        />
        <div id="phone-error" class="error-msg text-xs text-error font-medium items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
          <span>Introduce un número de teléfono válido (mínimo 9 dígitos).</span>
        </div>
      </div>

      <div class="field flex flex-col gap-1.5">
        <label class="font-label-button text-sm text-on-surface" for="contact-email">
          Correo electrónico <span class="text-primary" aria-hidden="true">*</span>
        </label>
        <span id="email-hint" class="text-xs text-text-muted">
          Para enviarte confirmación escrita
        </span>
        <input
          class="form-control w-full px-4 py-3 bg-surface-alt/50 focus:bg-surface-container-lowest text-on-surface border border-border-subtle placeholder:text-text-muted/60 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-sans text-sm"
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="valeria@estudiolevante.es"
          aria-describedby="email-hint"
          aria-errormessage="email-error"
        />
        <div id="email-error" class="error-msg text-xs text-error font-medium items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
          <span>Introduce una dirección de correo electrónico válida.</span>
        </div>
      </div>
    </div>

    <!-- Row 3: Mensaje Textarea -->
    <div class="field flex flex-col gap-1.5">
      <label class="font-label-button text-sm text-on-surface" for="contact-message">
        Mensaje <span class="text-primary" aria-hidden="true">*</span>
      </label>
      <span id="message-hint" class="text-xs text-text-muted">
        Detalla tu consulta (mínimo 10 caracteres)
      </span>
      <textarea
        class="form-control w-full px-4 py-3 bg-surface-alt/50 focus:bg-surface-container-lowest text-on-surface border border-border-subtle placeholder:text-text-muted/60 rounded-xl focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-sans text-sm resize-y"
        id="contact-message"
        name="message"
        required
        minlength="10"
        maxlength="2000"
        rows="4"
        placeholder="Cuéntanos qué necesitas consultar sobre productos de segunda mano, outlet o punto de paquetería..."
        aria-describedby="message-hint"
        aria-errormessage="message-error"
      ></textarea>
      <div id="message-error" class="error-msg text-xs text-error font-medium items-center gap-1.5">
        <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
        <span>Por favor, escribe un mensaje con al menos 10 caracteres.</span>
      </div>
    </div>

    <!-- Privacy Checkbox & RGPD Informative Notice -->
    <div class="field flex flex-col pt-1">
      <div class="flex items-start gap-2.5">
        <input
          class="form-control mt-1 h-4 w-4 rounded-sm border-border-subtle accent-primary text-primary focus:ring-primary cursor-pointer"
          id="privacy-check"
          name="privacy"
          required
          type="checkbox"
          aria-errormessage="privacy-error"
        />
        <label class="font-sans text-xs text-secondary cursor-pointer select-none leading-relaxed" for="privacy-check">
          He leído y acepto la <a href="/privacidad" target="_blank" class="text-on-surface font-semibold underline decoration-primary hover:text-primary transition-colors">política de privacidad</a> y el tratamiento de mis datos exclusivamente para responder a esta solicitud. <span class="text-primary" aria-hidden="true">*</span>
        </label>
      </div>
      <p class="font-mono text-[11px] text-text-muted mt-2 ml-6.5 leading-normal">
        Responsable: {SITE.brand.name} · Finalidad: Gestión de consultas y contacto · Derechos: Acceso, rectificación y supresión en {SITE.contact.email}.
      </p>
    </div>

    <!-- Cloudflare Turnstile Anti-Spam Widget with Security Reassurance Container -->
    <div class="field flex flex-col gap-1.5 pt-1">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-2xl bg-surface-alt/40 border border-border-subtle/70">
        <div
          id="turnstile-widget"
          class="cf-turnstile min-h-[65px]"
          data-sitekey={turnstileSiteKey}
        ></div>
        <div class="flex items-center gap-2 text-text-muted font-mono text-xs pr-2 select-none">
          <span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">verified_user</span>
          <span>Protección Cloudflare Turnstile · Envío seguro</span>
        </div>
      </div>
      <div id="turnstile-error" class="error-msg text-xs text-error font-medium items-center gap-1.5" role="alert">
        <span class="material-symbols-outlined text-[15px] shrink-0" aria-hidden="true">error</span>
        <span>Por favor, completa la verificación anti-spam antes de enviar el formulario.</span>
      </div>
    </div>

    <!-- Submit Button & Full Interaction Cycle -->
    <div class="pt-2 flex flex-col gap-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <button
          id="contact-submit-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-primary hover:bg-primary-hover disabled:opacity-60 text-on-primary font-label-button text-sm rounded-xl transition-all active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary cursor-pointer"
          type="submit"
        >
          <span data-submit-label>Enviar Mensaje</span>
          <span data-submit-icon class="material-symbols-outlined text-[18px]" aria-hidden="true">send</span>
        </button>
        <div class="flex items-center gap-1.5 text-text-muted font-mono text-xs">
          <span class="material-symbols-outlined text-[16px] text-primary" aria-hidden="true">schedule</span>
          <span>Respuesta &lt; 24 h laborables</span>
        </div>
      </div>

      <!-- Skeletal Loading State -->
      <div
        id="form-loading-skeleton"
        aria-hidden="true"
        class="hidden p-4 rounded-xl bg-surface-alt border border-border-subtle flex-col gap-2.5 animate-pulse"
      >
        <div class="h-3.5 w-48 bg-surface-container-high rounded"></div>
        <div class="h-3 w-full max-w-md bg-surface-container rounded"></div>
      </div>

      <!-- Success Feedback State -->
      <div
        role="status"
        aria-live="polite"
        tabindex="-1"
        class="hidden p-5 rounded-2xl bg-mint-wash border border-primary/30 text-on-surface items-start justify-between gap-4 mt-1 outline-none"
        id="form-feedback"
      >
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5" aria-hidden="true">check_circle</span>
          <div class="flex flex-col">
            <span class="font-display font-bold text-base text-surface-dark">Consulta registrada en {SITE.brand.name}</span>
            <span class="font-sans text-xs text-secondary mt-1 leading-relaxed">
              Hemos recibido tu mensaje correctamente. Nuestro equipo de Alfafar te responderá en horario comercial. Si necesitas confirmación inmediata, llámanos al <a href={SITE.contact.phoneHref} class="font-mono font-semibold underline text-on-surface">{SITE.contact.phoneDisplay}</a>.
            </span>
          </div>
        </div>
      </div>

      <!-- Error Feedback Alert -->
      <div
        role="alert"
        aria-live="assertive"
        tabindex="-1"
        class="hidden p-5 rounded-2xl bg-red-50/80 border border-error/30 text-on-surface items-start justify-between gap-4 mt-1 outline-none"
        id="form-error-alert"
      >
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-error text-[22px] shrink-0 mt-0.5" aria-hidden="true">error</span>
          <div class="flex flex-col">
            <span class="font-display font-bold text-base text-surface-dark">No se pudo enviar la consulta</span>
            <span id="form-error-message" class="font-sans text-xs text-secondary mt-1 leading-relaxed">
              Ha ocurrido un problema al procesar el mensaje. Por favor, revísalo o contacta directamente con nosotros en el <a href={SITE.contact.phoneHref} class="font-mono font-semibold underline text-on-surface">{SITE.contact.phoneDisplay}</a>.
            </span>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<style>
  .error-msg {
    display: none;
  }

  .form-control:user-invalid,
  .form-control.user-invalid-fallback {
    border-color: #ba1a1a;
    background-color: #fff8f7;
  }

  .form-control:user-invalid + .error-msg,
  .form-control.user-invalid-fallback + .error-msg,
  .field:has(.form-control:user-invalid) > .error-msg,
  .field:has(.form-control.user-invalid-fallback) > .error-msg {
    display: flex;
  }

  .form-control:user-valid,
  .form-control.user-valid-fallback {
    border-color: #059652;
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    if (!form) return;

    let turnstileWidgetId = null;
    let currentTurnstileToken = '';

    const syncAria = (el) => {
      if (!el || typeof el.matches !== 'function' || !el.classList?.contains('form-control')) return;
      try {
        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
      } catch {}
    };

    form.addEventListener('blur', (e) => syncAria(e.target), true);
    form.addEventListener('input', (e) => {
      if (e.target?.hasAttribute?.('aria-invalid')) syncAria(e.target);
    });

    // Fallback for browsers without :user-invalid support
    const UserInvalidFallback = (() => {
      const dirtyState = new WeakMap();

      const updateState = (input) => {
        const isValid = input.checkValidity();
        input.classList.toggle('user-invalid-fallback', !isValid);
        input.classList.toggle('user-valid-fallback', isValid);
        if (!isValid) {
          input.setAttribute('aria-invalid', 'true');
        } else {
          input.removeAttribute('aria-invalid');
        }
      };

      const handleEvent = (event) => {
        const input = event.target;
        if (event.type === 'reset') {
          const controls = input.elements || [];
          for (const control of controls) {
            dirtyState.delete(control);
            control.classList.remove('user-invalid-fallback', 'user-valid-fallback');
            control.removeAttribute('aria-invalid');
          }
          return;
        }
        if (!input?.checkValidity) return;

        if (event.type === 'input' || event.type === 'change') {
          const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
          state.hasInteracted = true;
          dirtyState.set(input, state);
          if (state.hasBlurred) updateState(input);
        } else if (event.type === 'blur') {
          const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
          state.hasBlurred = true;
          dirtyState.set(input, state);
          if (state.hasInteracted) updateState(input);
        }
      };

      const init = (root = document) => {
        if (typeof CSS !== 'undefined' && CSS.supports && CSS.supports('selector(:user-invalid)')) return;
        root.addEventListener('blur', handleEvent, true);
        root.addEventListener('input', handleEvent);
        root.addEventListener('change', handleEvent);
        root.addEventListener('reset', handleEvent, true);
      };

      return { init };
    })();

    UserInvalidFallback.init(form);

    // Turnstile lifecycle setup
    const initTurnstile = () => {
      const container = document.getElementById('turnstile-widget');
      if (!container || !window.turnstile || turnstileWidgetId !== null) return;

      try {
        const sitekey = container.getAttribute('data-sitekey') || '0x4AAAAAAFWf9LvYLm41PcPy';
        turnstileWidgetId = window.turnstile.render('#turnstile-widget', {
          sitekey: sitekey,
          callback: (token) => {
            currentTurnstileToken = token;
            const turnstileError = document.getElementById('turnstile-error');
            if (turnstileError) {
              turnstileError.classList.add('hidden');
              turnstileError.classList.remove('flex');
            }
          },
          'expired-callback': () => {
            currentTurnstileToken = '';
          },
          'error-callback': () => {
            currentTurnstileToken = '';
          },
        });
      } catch (e) {
        // Safe failover
      }
    };

    if (window.turnstile) {
      initTurnstile();
    } else {
      const timer = setInterval(() => {
        if (window.turnstile) {
          clearInterval(timer);
          initTurnstile();
        }
      }, 200);
      setTimeout(() => clearInterval(timer), 6000);
    }

    const resetTurnstile = () => {
      currentTurnstileToken = '';
      if (window.turnstile && turnstileWidgetId !== null) {
        try {
          window.turnstile.reset(turnstileWidgetId);
        } catch {}
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const feedback = document.getElementById('form-feedback');
      const errorAlert = document.getElementById('form-error-alert');
      const errorMessage = document.getElementById('form-error-message');
      const turnstileError = document.getElementById('turnstile-error');
      const skeleton = document.getElementById('form-loading-skeleton');
      const submitBtn = document.getElementById('contact-submit-btn');
      const label = submitBtn?.querySelector('[data-submit-label]');

      // Reset feedback visibility
      feedback?.classList.add('hidden');
      feedback?.classList.remove('flex');
      errorAlert?.classList.add('hidden');
      errorAlert?.classList.remove('flex');
      turnstileError?.classList.add('hidden');
      turnstileError?.classList.remove('flex');

      // Native validity check
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Check Turnstile token
      let token = currentTurnstileToken;
      if (!token && window.turnstile && turnstileWidgetId !== null) {
        try {
          token = window.turnstile.getResponse(turnstileWidgetId);
        } catch {}
      }
      if (!token) {
        const fallbackInput = form.querySelector('[name="cf-turnstile-response"]');
        if (fallbackInput && fallbackInput.value) {
          token = fallbackInput.value;
        }
      }

      if (!token) {
        if (turnstileError) {
          turnstileError.classList.remove('hidden');
          turnstileError.classList.add('flex');
        }
        return;
      }

      // Loading state
      form.setAttribute('aria-busy', 'true');
      submitBtn?.setAttribute('disabled', 'true');
      if (label) label.textContent = 'Enviando consulta...';
      skeleton?.classList.remove('hidden');
      skeleton?.classList.add('flex');

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') || ''),
        phone: String(formData.get('phone') || ''),
        email: String(formData.get('email') || ''),
        subject: String(formData.get('subject') || ''),
        message: String(formData.get('message') || ''),
        privacy: formData.get('privacy') === 'on' || formData.get('privacy') === 'true',
        turnstileToken: token,
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => null);

        skeleton?.classList.add('hidden');
        skeleton?.classList.remove('flex');
        form.removeAttribute('aria-busy');
        submitBtn?.removeAttribute('disabled');
        if (label) label.textContent = 'Enviar Mensaje';

        if (response.ok && data?.ok) {
          // Success Feedback
          feedback?.classList.remove('hidden');
          feedback?.classList.add('flex');
          feedback?.focus();
          form.reset();
          resetTurnstile();
          form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
        } else {
          // Error Feedback
          const msg = data?.error?.message || 'No se pudo enviar tu consulta en este momento. Por favor, revisa los datos o llámanos.';
          if (errorMessage) errorMessage.textContent = msg;
          errorAlert?.classList.remove('hidden');
          errorAlert?.classList.add('flex');
          errorAlert?.focus();
          resetTurnstile();
        }
      } catch (networkError) {
        skeleton?.classList.add('hidden');
        skeleton?.classList.remove('flex');
        form.removeAttribute('aria-busy');
        submitBtn?.removeAttribute('disabled');
        if (label) label.textContent = 'Enviar Mensaje';

        if (errorMessage) {
          errorMessage.textContent = 'Error de red o conexión. Por favor, llámanos directamente por teléfono o escribe por WhatsApp.';
        }
        errorAlert?.classList.remove('hidden');
        errorAlert?.classList.add('flex');
        errorAlert?.focus();
        resetTurnstile();
      }
    });
  })();
</script>
