---
import { SITE } from '../config/site';

interface Props {
  currentPage?: 'home' | 'paqueteria' | 'outlet' | 'contacto';
}

const { currentPage = 'home' } = Astro.props;

const navLinks = [
  { label: 'Inicio', href: '/', active: currentPage === 'home' },
  { label: 'Paquetería', href: '/paqueteria', active: currentPage === 'paqueteria' },
  { label: 'Outlet', href: '/outlet', active: currentPage === 'outlet' },
  { label: 'Contacto', href: '/contacto', active: currentPage === 'contacto' },
];
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-space-md focus:py-space-sm focus:bg-primary focus:text-on-primary focus:rounded-md focus:font-label-button focus:shadow-lg"
>
  Saltar al contenido principal
</a>

<header class="fixed top-0 left-0 right-0 w-full z-40 bg-emerald-200/80 backdrop-blur-md border-b border-primary/25 shadow-xs">
  <div class="h-28 sm:h-32 lg:h-36 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4 lg:gap-6">
    <div class="flex items-center gap-5">
      <a
        class="flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary rounded-md py-1"
        href="/"
        aria-label={`${SITE.brand.name} — Ir a Inicio`}
      >
        <img
          src="/logo-rapido-pack-valencia.png"
          alt={SITE.brand.name}
          width="172"
          height="120"
          class="h-[96px] sm:h-[108px] lg:h-[120px] w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
        />
      </a>

      <!-- Live Store Status Indicator (Valencia Time) -->
      <div
        id="header-live-status"
        class="hidden xl:inline-flex items-center gap-2 pl-5 border-l border-primary/20 text-xs font-mono font-medium text-text-muted whitespace-nowrap"
        aria-live="polite"
        data-weekday-open={SITE.schedule.weekdays.openMinutes}
        data-weekday-close={SITE.schedule.weekdays.closeMinutes}
        data-sat-open={SITE.schedule.saturday.openMinutes}
        data-sat-close={SITE.schedule.saturday.closeMinutes}
        data-weekday-open-label={SITE.schedule.weekdays.open}
        data-weekday-close-label={SITE.schedule.weekdays.close}
        data-sat-open-label={SITE.schedule.saturday.open}
        data-sat-close-label={SITE.schedule.saturday.close}
      >
        <span data-status-dot class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
        <span data-status-text>{SITE.schedule.summaryBadge}</span>
      </div>
    </div>

    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-1.5 lg:gap-2.5 whitespace-nowrap">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? 'page' : undefined}
          class:list={[
            'px-4 py-2.5 rounded-xl font-label-button text-lg font-bold uppercase tracking-wide whitespace-nowrap transition-all active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
            link.active
              ? 'bg-white text-primary shadow-xs border border-primary/20'
              : 'text-surface-dark/80 hover:text-primary hover:bg-white/60',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5 lg:gap-3 shrink-0 whitespace-nowrap">
      <a
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-primary/20 bg-white/70 hover:bg-white text-surface-dark font-mono text-sm font-bold whitespace-nowrap transition-all active:scale-[0.98]"
        href={SITE.contact.phoneHref}
      >
        <span class="material-symbols-outlined text-[18px] text-primary leading-none" aria-hidden="true">call</span>
        <span class="tabular-nums">{SITE.contact.phoneDisplay}</span>
      </a>

      <!-- Mobile Menu Disclosure -->
      <details class="md:hidden relative group">
        <summary
          aria-label="Abrir menú de navegación"
          class="list-none flex items-center justify-center w-12 h-12 rounded-xl border border-primary/20 bg-white/70 text-surface-dark hover:bg-white cursor-pointer transition-transform active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-primary"
        >
          <span class="material-symbols-outlined text-[26px] group-open:!hidden" aria-hidden="true">menu</span>
          <span class="material-symbols-outlined text-[26px] !hidden group-open:!inline-block" aria-hidden="true">close</span>
        </summary>
        <nav
          aria-label="Navegación móvil"
          class="absolute right-0 mt-3 w-[calc(100vw-2rem)] sm:w-80 max-w-xs bg-surface-container-lowest rounded-2xl border border-border-subtle shadow-2xl p-3 flex flex-col gap-1.5"
        >
          <!-- Live Store Status for Mobile -->
          <div
            id="header-mobile-live-status"
            class="px-4 py-3 rounded-xl bg-surface-alt/70 border border-border-subtle flex items-center gap-2 text-xs font-mono font-medium text-text-muted mb-1"
            aria-live="polite"
            data-mobile-status
          >
            <span data-status-dot class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
            <span data-status-text>{SITE.schedule.summaryBadge}</span>
          </div>

          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              class:list={[
                'px-4 py-3.5 min-h-[48px] flex items-center justify-between rounded-xl font-label-button text-base font-bold uppercase tracking-wide transition-colors active:scale-[0.99]',
                link.active
                  ? 'bg-mint-wash text-primary font-bold'
                  : 'text-surface-dark hover:bg-surface-alt font-bold',
              ]}
            >
              <span>{link.label}</span>
              {link.active && (
                <span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
              )}
            </a>
          ))}
          <div class="pt-2.5 mt-1 border-t border-border-subtle flex flex-col gap-2">
            <a
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3.5 min-h-[48px] bg-surface-alt text-surface-dark font-mono text-sm font-bold rounded-xl active:scale-[0.99] transition-transform"
              href={SITE.contact.phoneHref}
            >
              <span class="material-symbols-outlined text-[18px] text-primary" aria-hidden="true">call</span>
              <span>{SITE.contact.phoneDisplay}</span>
            </a>
            <a
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3.5 min-h-[48px] bg-primary hover:bg-primary-hover text-on-primary font-label-button text-base font-bold rounded-xl active:scale-[0.99] transition-all shadow-sm"
              href={SITE.location.mapsUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">location_on</span>
              <span>Cómo llegar al local</span>
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const desktopContainer = document.getElementById('header-live-status');
    const mobileContainer = document.getElementById('header-mobile-live-status');
    const containers = [desktopContainer, mobileContainer].filter(Boolean);
    if (containers.length === 0) return;

    try {
      const now = new Date();
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Madrid',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(now);

      const map = Object.fromEntries(parts.map((p) => [p.type, p.value]));
      const source = desktopContainer || mobileContainer;
      const weekdayOpenMins = parseInt(source?.dataset.weekdayOpen || '570', 10);
      const weekdayCloseMins = parseInt(source?.dataset.weekdayClose || '1200', 10);
      const satOpenMins = parseInt(source?.dataset.satOpen || '600', 10);
      const satCloseMins = parseInt(source?.dataset.satClose || '900', 10);

      const weekdayOpenLabel = source?.dataset.weekdayOpenLabel || '09:30';
      const weekdayCloseLabel = source?.dataset.weekdayCloseLabel || '20:00';
      const satOpenLabel = source?.dataset.satOpenLabel || '10:00';
      const satCloseLabel = source?.dataset.satCloseLabel || '15:00';

      const mins = parseInt(map.hour, 10) * 60 + parseInt(map.minute, 10);
      const day = map.weekday;

      let isOpen = false;
      let label = `Cerrado · Abre Lunes ${weekdayOpenLabel}`;

      if (['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].includes(day)) {
        if (mins >= weekdayOpenMins && mins < weekdayCloseMins) {
          isOpen = true;
          label = `Abierto ahora · Hasta ${weekdayCloseLabel}`;
        } else if (mins < weekdayOpenMins) {
          label = `Abre hoy a las ${weekdayOpenLabel}`;
        } else {
          label = day === 'Fri' ? `Abre Sáb a las ${satOpenLabel}` : `Abre mañana ${weekdayOpenLabel}`;
        }
      } else if (day === 'Sat') {
        if (mins >= satOpenMins && mins < satCloseMins) {
          isOpen = true;
          label = `Abierto ahora · Hasta ${satCloseLabel}`;
        } else if (mins < satOpenMins) {
          label = `Abre hoy a las ${satOpenLabel}`;
        } else {
          label = `Cerrado · Abre Lunes ${weekdayOpenLabel}`;
        }
      }

      for (const c of containers) {
        const dot = c.querySelector('[data-status-dot]');
        const text = c.querySelector('[data-status-text]');
        if (dot) {
          dot.className = isOpen
            ? 'w-2 h-2 rounded-full bg-primary ring-4 ring-primary/15 shrink-0'
            : 'w-2 h-2 rounded-full bg-amber-500 shrink-0';
        }
        if (text) {
          text.textContent = label;
        }
      }
    } catch {}
  })();
</script>
