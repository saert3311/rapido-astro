---
import Layout from '../layouts/Layout.astro';
import StoreLocator from '../components/StoreLocator.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const features = [
  {
    icon: 'local_shipping',
    title: 'Mercancía Nueva Cada Lunes',
    description: 'Todos los lunes a las 09:30 abrimos con lote recién llegado de stock nuevo de outlet y primeras marcas.',
    tag: 'Día Clave',
    tagIcon: 'arrow_forward',
  },
  {
    icon: 'sell',
    title: 'Precios de Outlet',
    description: 'Descuentos directos en primeras marcas de tecnología, pequeño electrodoméstico y artículos para el hogar.',
    tag: 'Hasta 70% Menos',
    tagIcon: 'trending_down',
  },
  {
    icon: 'fact_check',
    title: 'Comprueba en Persona',
    description: 'Abre, inspecciona y prueba el producto en nuestras mesas con enchufe antes de pagar. Sin sorpresas.',
    tag: 'Revisión Libre',
    tagIcon: 'done_all',
  },
  {
    icon: 'package_2',
    title: 'Punto de Paquetería Oficial',
    description: 'Recogida y devolución rápida de tus compras online (Amazon Hub, GLS, CTT, InPost, SEUR) con fácil aparcamiento.',
    tag: 'Recogida y Devolución',
    tagIcon: 'inventory',
  },
];

const categories = [
  {
    featured: true,
    badge: 'Más Popular',
    badgeIcon: 'local_fire_department',
    meta: 'Apertura 09:30',
    title: 'Lunes de Reposición Total',
    description: 'Cada lunes renovamos las estanterías con nuevos lotes de outlet y primeras marcas. Es el mejor momento para encontrar oportunidades desde primera hora.',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDaHzGlsNBhqI6dGEVjkag7N1ER9cekBn4iZpAeZEsarx0HY1TUmZvSnExkeK2wgGNFaCWhiUbKgTnecRDWV7ko6l8i8FmFRAla0T7t3OJEQFM8JopoIc5gKYPzvMaVZouAGK2_adK_LF-c-X705yPIBs_yWPYzLV_SuVDLkkhNQNemMGMerfAUXM-Wyv2HC9IXInbHlROll0_lVyNYiDdfINcHbFGstPSSjkfwfr8Z',
    imageAlt: 'Estanterías de Rápido Pack con lotes de liquidación listos para el lunes por la mañana',
    footerText: 'Llegar temprano = mayor variedad',
    footerIcon: 'alarm',
  },
  {
    featured: false,
    badge: 'Alta Rotación',
    badgeIcon: 'bolt',
    meta: 'Marcas Top',
    title: 'Tecnología y Hogar',
    description: 'Auriculares, cafeteras, aspiradores, freidoras de aire, periféricos y pequeño electrodoméstico con grandes descuentos frente a su PVP.',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuA8Q6qjd7S5aQoOiAWHM_ltBs3Sw9i1qTDShJsUG4KBsC5IjdyrE46ewPpRn-qTPqFzKN78n2IJo4hn7yOacEXYD1UC7uEix_ltNBnPuscLQdwh48O4jxQdmMUXZC9jbr3JCWC1T9C5n48U26IstvGl8S5GhNqA578rurb7R8WTm9OR8M9PIqWGX3RB08DXEBvDKHDccwMVpxWN8oNB9Yo3I6iPMgIKI5i0OILwJOef',
    imageAlt: 'Electrónica de consumo, auriculares, freidoras de aire y aspiradores en exposición',
    footerText: 'Mesa de prueba con enchufe en tienda',
    footerIcon: 'power',
  },
  {
    featured: false,
    badge: 'Oportunidades',
    badgeIcon: 'handyman',
    meta: 'Variedad Semanal',
    title: 'Herramientas y Ocio',
    description: 'Herramientas de bricolaje, equipamiento deportivo, menaje del hogar y artículos de oportunidad que se renuevan cada semana sin catálogo fijo.',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuChww7rAfkFGRSpjGXAb-TvEqExKoIksWmlPuFRAxqv8s6QUXMWC4RiNA97QsRSGUmWZIw2udXf7osybslqZPHE4NcMoPLNfDoDmQls_vfLEMqie3wc04npDB_I5gvtBZqC5p0fy6JwEbJvz-z_AbzE9KhS8STZInVQyhA9flNZWPrifRK4CQB3jIOfpPn5vJNLc6ZvaNlCL-1ABdLFtgUAXKtsaLoZhpV5ONE2jm0w',
    imageAlt: 'Herramientas de bricolaje, accesorios deportivos y menaje en tienda de liquidación',
    footerText: 'Nuevos lotes cada 7 días',
    footerIcon: 'sync',
  },
];

const homeFaqs = [
  {
    icon: 'calendar_month',
    question: '¿Qué día entra mercancía nueva en Rápido Pack?',
    answer: 'Todos los lunes abrimos a las <strong>09:30 horas</strong> con la nueva descarga de lotes de outlet y primeras marcas listas en estanterías. Es el momento preferido por nuestros clientes habituales para encontrar las mejores oportunidades de la semana.',
  },
  {
    icon: 'schedule',
    question: '¿Dónde estáis exactamente y cuál es el horario?',
    answer: 'Estamos en <strong>Carrer del Comte Ronrée, 8, 46910 Alfafar (Valencia)</strong>. Nuestro horario ininterrumpido es de <strong>lunes a viernes de 09:30 a 20:00</strong> y los <strong>sábados de 10:00 a 15:00</strong>. Los domingos permanecemos cerrados.',
  },
  {
    icon: 'fact_check',
    question: '¿Puedo ver y comprobar los productos antes de comprar?',
    answer: 'Sí. Esa es nuestra principal ventaja frente a la compra online a ciegas. En el local puedes abrir las cajas, revisar el estado estético y probar los aparatos eléctricos en nuestra zona de enchufes antes de pasar por caja.',
  },
  {
    icon: 'storefront',
    question: '¿Hacéis envíos online o tenéis catálogo web?',
    answer: 'Vendemos exclusivamente en persona en nuestra tienda física de Alfafar. Como el inventario rota a diario y cada unidad es única por orden de llegada, priorizamos ofrecerte el precio más bajo directamente en tienda.',
  },
];
---

<Layout title="Rápido Pack · Alfafar, Valencia — Tienda Outlet y Punto de Paquetería" currentPage="home">
  <div class="flex flex-col w-full">
    <!-- 1. Hero Section -->
    <section class="w-full bg-surface-container-lowest pt-space-lg pb-margin-lg border-b border-border-subtle">
      <div class="max-w-[1200px] mx-auto px-margin flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded bg-mint-wash text-primary font-label-badge text-label-badge border border-primary/20 mb-space-md">
          <span class="material-symbols-outlined text-[16px]" aria-hidden="true">inventory_2</span>
          <span>MERCANCÍA NUEVA TODOS LOS LUNES · ALFAFAR (VALENCIA)</span>
        </div>

        <h1 class="font-headline-hero text-headline-hero-mobile md:text-headline-hero text-surface-dark max-w-4xl">
          Outlet de Primeras Marcas en Valencia a <span class="text-primary">Precios de Oportunidad</span>
        </h1>

        <p class="mt-space-md font-body-lead text-base md:text-body-lead text-text-muted max-w-2xl">
          Visítanos en Rápido Pack Alfafar. Productos revisados de tecnología, hogar y herramientas con grandes descuentos, además de punto oficial de paquetería. Inspecciona, prueba y llévatelo al instante.
        </p>

        <div class="mt-space-lg flex flex-col sm:flex-row items-center gap-space-sm w-full sm:w-auto">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-space-xl py-3.5 bg-primary hover:bg-primary-hover text-on-primary font-label-button text-label-button rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="#ubicacion"
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">near_me</span>
            <span>Ver Ubicación y Horarios</span>
          </a>
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-space-lg py-3.5 bg-surface-container-lowest hover:bg-surface-alt text-surface-dark border border-border-subtle font-label-button text-label-button rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            href="tel:685119511"
          >
            <span class="material-symbols-outlined text-[20px] text-primary" aria-hidden="true">call</span>
            <span class="tabular-nums">685 11 95 11</span>
          </a>
        </div>

        <div class="mt-space-md flex flex-wrap items-center justify-center gap-x-space-md gap-y-1.5 font-body-sm text-xs md:text-sm text-text-muted">
          <span class="inline-flex items-center gap-1.5 font-semibold text-surface-dark">
            <span class="material-symbols-outlined text-primary text-[18px]" aria-hidden="true">storefront</span>
            Carrer del Comte Ronrée, 8, Alfafar
          </span>
          <span class="hidden sm:inline text-border-subtle" aria-hidden="true">|</span>
          <span class="inline-flex items-center gap-1 font-semibold text-surface-dark">
            <span class="material-symbols-outlined text-amber-500 text-[18px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
            5.0 en Google Reviews
          </span>
          <span class="hidden sm:inline text-border-subtle" aria-hidden="true">|</span>
          <span class="tabular-nums">L–V 09:30–20:00 · Sáb 10:00–15:00</span>
        </div>

        <!-- Hero Visual Showcase (LCP Candidate) -->
        <div class="mt-space-xl w-full max-w-5xl rounded-lg overflow-hidden border border-border-subtle bg-surface-container relative">
          <div class="relative aspect-[16/9] md:aspect-[21/9] w-full">
            <img
              class="w-full h-full object-cover"
              alt="Interior de la tienda física de liquidaciones Rápido Pack en Alfafar, Valencia, con estanterías organizadas de tecnología y hogar"
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuCnEht2Eb9QvC4upP9sSNRjPxo_dSrirRJEdm0-jsFXr6qTggNqyXZ-fA1OKH5hhL7UJM9fe8xiY0KDdi_3QA1qnv9VqWq--YXxwiyCvQDHPQhrg7U4tO5vQhGt8Ti1t8vzz1XzMVS0R6pLxi7ayZSBi7sOLz-XTdkJeeY_gaaeCIK-P0ihDsCDeEV7og8cRPxqHJ46zgRA5ReKLKrQ4JDu2PI_pYuUr3E0I_JNw3Yk"
              fetchpriority="high"
              width="1024"
              height="440"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-dark/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-space-sm sm:bottom-space-md left-space-sm sm:left-space-md right-space-sm sm:right-space-md flex items-center justify-between text-on-primary">
              <div class="flex items-center gap-2 bg-surface-dark/90 backdrop-blur-sm px-3 py-1.5 rounded text-xs">
                <span class="material-symbols-outlined text-primary-fixed text-[18px]" aria-hidden="true">verified</span>
                <span class="font-label-badge uppercase tracking-wider">Stock Físico Real · Sin Intermediarios</span>
              </div>
              <div class="hidden sm:flex items-center gap-1.5 bg-surface-dark/90 backdrop-blur-sm px-3 py-1.5 rounded font-body-sm text-xs">
                <span class="w-2 h-2 rounded-full bg-primary-fixed" aria-hidden="true"></span>
                <span>Inspección libre en tienda</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Ventajas y Punto de Paquetería (4 Columnas) -->
    <section class="w-full bg-surface-alt py-margin-lg border-b border-border-subtle" id="como-funciona">
      <div class="max-w-[1200px] mx-auto px-margin">
        <div class="text-center max-w-2xl mx-auto mb-space-xl">
          <span class="inline-block font-label-badge text-label-badge text-primary uppercase tracking-widest bg-mint-wash px-3 py-1 rounded">
            Ventajas Rápido Pack
          </span>
          <h2 class="mt-2 font-headline-lg text-headline-lg-mobile md:text-headline-lg text-surface-dark">
            ¿Por qué visitarnos en Alfafar?
          </h2>
          <p class="font-body-regular text-body-regular text-text-muted mt-2">
            Combinamos liquidaciones verificadas en persona con la comodidad de recoger o devolver tus paquetes en un mismo lugar.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
          {features.map((feature) => (
            <article class="bg-surface-container-lowest p-space-lg rounded-lg border border-border-subtle hover:border-primary/40 transition-colors flex flex-col justify-between">
              <div>
                <div class="w-12 h-12 rounded-md bg-mint-wash flex items-center justify-center text-primary mb-space-md">
                  <span class="material-symbols-outlined text-[24px]" aria-hidden="true">{feature.icon}</span>
                </div>
                <h3 class="font-headline-md text-lg text-surface-dark mb-2">{feature.title}</h3>
                <p class="font-body-sm text-body-sm text-text-muted leading-relaxed">{feature.description}</p>
              </div>
              <div class="mt-space-md pt-3 border-t border-border-subtle/60 text-primary font-label-badge text-xs uppercase tracking-wider flex items-center gap-1.5">
                <span>{feature.tag}</span>
                <span class="material-symbols-outlined text-[15px]" aria-hidden="true">{feature.tagIcon}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Lunes de Reposición y Categorías (3 Columnas) -->
    <section class="w-full bg-surface-container-lowest py-margin-lg border-b border-border-subtle section-deferred" id="lunes-de-stock">
      <div class="max-w-[1200px] mx-auto px-margin">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
          <div>
            <span class="inline-block font-label-badge text-label-badge text-primary uppercase tracking-widest bg-mint-wash px-3 py-1 rounded">
              Inventario Semanal
            </span>
            <h2 class="mt-2 font-headline-lg text-headline-lg-mobile md:text-headline-lg text-surface-dark">
              Lunes de Reposición y Categorías
            </h2>
          </div>
          <p class="font-body-regular text-sm md:text-base text-text-muted max-w-md">
            El stock físico se renueva cada semana. Los lotes más buscados tienen mayor disponibilidad durante las primeras horas del lunes.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter items-stretch">
          {categories.map((cat) => (
            <article
              class:list={[
                'rounded-lg p-space-lg bg-surface-container-lowest border transition-colors flex flex-col justify-between',
                cat.featured ? 'border-border-subtle border-t-4 border-t-primary' : 'border-border-subtle hover:border-primary/40',
              ]}
            >
              <div>
                <div class="flex items-center justify-between mb-space-md">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 px-2.5 py-1 rounded font-label-badge text-xs uppercase tracking-wider',
                      cat.featured ? 'bg-mint-wash text-primary' : 'bg-surface-alt text-secondary',
                    ]}
                  >
                    <span class="material-symbols-outlined text-[15px]" aria-hidden="true">{cat.badgeIcon}</span>
                    <span>{cat.badge}</span>
                  </span>
                  <span class="font-body-sm text-xs font-semibold text-text-muted">{cat.meta}</span>
                </div>

                <div class="h-44 w-full rounded-md overflow-hidden mb-space-md bg-surface-container border border-border-subtle/50">
                  <img
                    class="w-full h-full object-cover"
                    alt={cat.imageAlt}
                    src={cat.image}
                    loading="lazy"
                    decoding="async"
                    width="380"
                    height="176"
                  />
                </div>

                <h3 class="font-headline-md text-headline-md text-surface-dark mb-2">{cat.title}</h3>
                <p class="font-body-regular text-sm text-text-muted leading-relaxed">{cat.description}</p>
              </div>

              <div
                class:list={[
                  'mt-space-lg pt-3 flex items-center justify-between font-body-sm text-xs',
                  cat.featured ? 'p-2.5 rounded-md bg-mint-wash text-primary font-semibold' : 'border-t border-border-subtle/60 text-text-muted',
                ]}
              >
                <span>{cat.footerText}</span>
                <span class="material-symbols-outlined text-primary text-[18px]" aria-hidden="true">{cat.footerIcon}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Ubicación y Horarios -->
    <StoreLocator />

    <!-- 5. Preguntas Frecuentes (Native Exclusive Accordion) -->
    <section class="w-full bg-surface-container-lowest py-margin-lg border-t border-border-subtle section-deferred">
      <FaqAccordion
        badge="Preguntas Frecuentes"
        title="Resolvemos tus dudas antes de venir"
        subtitle="Todo lo que necesitas saber sobre el funcionamiento de nuestra tienda física y punto de paquetería en Alfafar."
        items={homeFaqs}
        groupName="home-faq"
      />
    </section>

    <!-- 6. Banner de Cierre / Conversión -->
    <section class="w-full bg-surface-dark text-on-primary py-margin-lg section-deferred">
      <div class="max-w-[1200px] mx-auto px-margin flex flex-col md:flex-row items-center justify-between gap-space-lg">
        <div class="max-w-xl text-center md:text-left">
          <span class="inline-flex items-center gap-2 font-label-badge text-xs text-primary-fixed uppercase tracking-wider bg-surface-container-lowest/10 px-3 py-1 rounded">
            <span class="w-2 h-2 rounded-full bg-primary-fixed" aria-hidden="true"></span>
            Próxima Descarga: Lunes 09:30 h
          </span>
          <h2 class="mt-2 font-headline-lg text-headline-lg-mobile md:text-headline-lg text-surface-container-lowest">
            Descubre las oportunidades de esta semana en tienda
          </h2>
          <p class="mt-2 font-body-regular text-sm md:text-base text-surface-variant">
            Acércate a Carrer del Comte Ronrée, 8 en Alfafar y comprueba en persona nuestro stock de primeras marcas.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-space-sm w-full md:w-auto shrink-0">
          <a
            class="inline-flex items-center justify-center gap-2 px-space-xl py-3.5 bg-primary hover:bg-primary-hover text-on-primary font-label-button text-sm rounded-md transition-colors text-center"
            href="https://www.google.com/maps/place//data=!4m2!3m1!19sChIJw5ZDyrhPYA0RASxZojeQoD0"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">near_me</span>
            <span>Cómo Llegar en Coche</span>
          </a>
          <a
            class="inline-flex items-center justify-center gap-2 px-space-lg py-3.5 bg-surface-container-lowest/10 hover:bg-surface-container-lowest/20 text-surface-container-lowest border border-surface-container-lowest/20 font-label-button text-sm rounded-md transition-colors text-center"
            href="/contacto"
          >
            <span class="material-symbols-outlined text-[20px]" aria-hidden="true">mail</span>
            <span>Contactar</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Mobile Sticky Bottom CTA -->
    <div class="md:hidden fixed bottom-3 left-3 right-3 z-40">
      <a
        class="w-full flex items-center justify-between px-space-md py-3 bg-primary hover:bg-primary-hover text-on-primary font-label-button text-sm rounded-md shadow-lg border border-primary-fixed/20"
        href="https://www.google.com/maps/place//data=!4m2!3m1!19sChIJw5ZDyrhPYA0RASxZojeQoD0"
        rel="noopener noreferrer"
        target="_blank"
      >
        <span class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">navigation</span>
          <span>Cómo llegar a Rápido Pack</span>
        </span>
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</Layout>
