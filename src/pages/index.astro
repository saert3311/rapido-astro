<script is:inline>
  (() => {
    const pill = document.getElementById('monday-countdown-pill');
    if (!pill) return;
    try {
      const now = new Date();
      const parts = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Madrid',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).formatToParts(now);
      const map = Object.fromEntries(parts.map((p) => [p.type, p.value]));
      const dayMap = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 0 };
      const d = dayMap[map.weekday] ?? 1;
      const mins = parseInt(map.hour, 10) * 60 + parseInt(map.minute, 10);

      if (d === 1 && mins >= 9 * 60 + 30 && mins < 20 * 60) {
        pill.textContent = 'HOY LUNES · LOTE NUEVO EN SALA';
      } else {
        const daysUntilMon = d === 1 && mins < 9 * 60 + 30 ? 0 : (8 - d) % 7 || 7;
        pill.textContent =
          daysUntilMon === 0
            ? 'Hoy 09:30 h · Apertura de lote'
            : `Próximo lote en ${daysUntilMon} ${daysUntilMon === 1 ? 'día' : 'días'} · Lun 09:30`;
      }
    } catch {}
  })();
</script>
