---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import StoreLocator from '../components/StoreLocator.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const contactChannels = [
  {
    icon: 'call',
    title: 'Llámanos directamente',
    value: '685 11 95 11',
    href: 'tel:685119511',
    external: false,
    description: 'Atención en horario comercial (L–V 09:30–20:00)',
    cta: 'Llamar ahora',
    ctaIcon: 'arrow_forward',
  },
  {
    icon: 'chat',
    title: 'Mensaje por WhatsApp',
    value: '685 11 95 11',
    href: 'https://wa.me/34685119511',
    external: true,
    description: 'Respuesta directa del equipo en el mismo día',
    cta: 'Abrir WhatsApp',
    ctaIcon: 'open_in_new',
  },
  {
    icon: 'mail',
    title: 'Correo de consultas',
    value: 'contacto@rapidopack.es',
    href: 'mailto:contacto@rapidopack.es',
    external: false,
    description: 'Para dudas generales, lotes o colaboraciones',
    cta: 'Enviar email',
    ctaIcon: 'outgoing_mail',
  },
  {
    icon: 'pin_drop',
    title: 'Visítanos en tienda',
    value: 'C/ Comte Ronrée, 8',
    href: 'https://maps.google.com/?q=Carrer+del+Comte+Ronr%C3%A9e,+8,+46910+Alfafar,+Valencia',
    external: true,
    description: '46910 Alfafar, Valencia · Aparcamiento gratuito',
    cta: 'Ver en Google Maps',
    ctaIcon: 'directions',
  },
];

const contactFaqs = [
  {
    icon: 'door_front',
    question: '¿Es necesario pedir cita para venir a la tienda?',
    answer: 'No, la entrada es 100% libre durante nuestro horario comercial. Puedes entrar, revisar las estanterías y probar los productos en nuestra zona habilitada al instante. Recomendamos acudir los lunes a primera hora para aprovechar el lote recién descargado.',
  },
  {
    icon: 'shopping_bag',
    question: '¿Puedo reservar un producto o lote por teléfono?',
    answer: 'Debido a la alta rotación y a los precios de liquidación de nuestro Outlet, las unidades individuales se asignan por estricto orden de llegada en tienda física. Si te interesa adquirir lotes completos al por mayor, escríbenos por WhatsApp para coordinar.',
  },
  {
    icon: 'package_2',
    question: '¿Hasta qué hora puedo recoger o entregar paquetes?',
    answer: 'El servicio oficial de paquetería (recogidas y devoluciones de Amazon Hub, GLS, InPost, CTT y SEUR) está operativo ininterrumpidamente durante todo el horario: lunes a viernes de 09:30 a 20:00 h y sábados de 10:00 a 15:00 h.',
  },
];
---

<Layout
  title="Contacto · Rápido Pack Alfafar, Valencia — Teléfono, Ubicación y Consultas"
  description="Contacta con Rápido Pack en Alfafar, Valencia. Teléfono 685 11 95 11, WhatsApp, horarios de reposición de los lunes y recogida de paquetería."
  currentPage="contacto"
>
  <div class="flex flex-col w-full">
    <!-- 1. Hero Section -->
    <section class="w-full bg-surface-alt pt-space-lg pb-14 border-b border-border-subtle">
      <div class="max-w-[1200px] mx-auto px-margin">
        <div class="max-w-3xl flex flex-col gap-space-xs items-start">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-mint-wash text-primary font-label-badge text-label-badge uppercase tracking-wider border border-primary/20">
            <span class="material-symbols-outlined text-[16px] leading-none" aria-hidden="true">storefront</span>
            ATENCIÓN Y CONSULTAS · TIENDA FÍSICA EN ALFAFAR
          </span>
          <h1 class="mt-1 font-headline-hero text-headline-hero-mobile md:text-headline-hero text-on-surface">
            Contacta con <span class="text-primary">Rápido Pack</span>
          </h1>
          <p class="font-body-lead text-base md:text-body-lead text-secondary max-w-2xl mt-1">
            ¿Tienes dudas sobre la entrada de nuevo stock los lunes, recogida de paquetería o disponibilidad en tienda? Llámanos, escríbenos o visítanos directamente en Alfafar.
          </p>
        </div>
      </div>
    </section>

    <!-- 2. Direct Contact Channels Grid (4 Cards) -->
    <section class="w-full bg-surface-container-lowest -mt-6 relative z-10 pb-margin-lg border-b border-border-subtle">
      <div class="max-w-[1200px] mx-auto px-margin">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
          {contactChannels.map((ch) => (
            <article class="bg-surface-container-lowest p-space-lg rounded-lg border border-border-subtle hover:border-primary/40 transition-colors flex flex-col justify-between">
              <div class="flex flex-col gap-2">
                <div class="w-11 h-11 rounded-md bg-mint-wash flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined text-[24px]" aria-hidden="true">{ch.icon}</span>
                </div>
                <div class="flex flex-col mt-1">
                  <span class="font-body-sm text-xs text-text-muted font-medium">{ch.title}</span>
                  <a
                    class="font-headline-sm text-base text-on-surface font-bold hover:text-primary transition-colors truncate mt-0.5"
                    href={ch.href}
                    target={ch.external ? '_blank' : undefined}
                    rel={ch.external ? 'noopener noreferrer' : undefined}
                  >
                    {ch.value}
                  </a>
                </div>
                <p class="font-body-sm text-xs text-secondary leading-relaxed">{ch.description}</p>
              </div>
              <div class="pt-3 mt-space-md border-t border-border-subtle/60">
                <a
                  class="inline-flex items-center gap-1.5 font-label-button text-xs text-primary hover:text-primary-hover transition-colors"
                  href={ch.href}
                  target={ch.external ? '_blank' : undefined}
                  rel={ch.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{ch.cta}</span>
                  <span class="material-symbols-outlined text-[16px]" aria-hidden="true">{ch.ctaIcon}</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Form + Store Inspection Info -->
    <section class="w-full bg-surface-alt py-margin-lg border-b border-border-subtle">
      <div class="max-w-[1200px] mx-auto px-margin">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-start">
          <div class="lg:col-span-7">
            <ContactForm />
          </div>

          <aside class="lg:col-span-5 flex flex-col gap-gutter">
            <!-- Parcel Point & Store Highlights Card -->
            <div class="bg-surface-container-lowest p-space-lg sm:p-space-xl rounded-lg border border-border-subtle flex flex-col gap-space-md">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-mint-wash rounded font-label-badge text-xs text-primary">
                  <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true">star</span>
                  <span>5.0 Google Reviews</span>
                </span>
                <span class="inline-flex items-center gap-1.5 font-body-sm text-xs text-primary font-semibold">
                  <span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
                  Atención Presencial
                </span>
              </div>

              <h3 class="font-headline-md text-headline-md text-on-surface">
                Servicios en nuestra tienda de Alfafar
              </h3>

              <ul class="space-y-3 font-body-sm text-sm text-secondary">
                <li class="flex items-start gap-2.5 p-3 rounded-md bg-surface-alt border border-border-subtle/60">
                  <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">local_shipping</span>
                  <div>
                    <strong class="text-on-surface block">Lunes de Reposición (09:30 h)</strong>
                    <span>Descarga semanal de lotes nuevos de tecnología, hogar y herramientas.</span>
                  </div>
                </li>
                <li class="flex items-start gap-2.5 p-3 rounded-md bg-surface-alt border border-border-subtle/60">
                  <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">package_2</span>
                  <div>
                    <strong class="text-on-surface block">Punto Oficial de Paquetería</strong>
                    <span>Recepción y devoluciones sin esperas durante todo el horario comercial.</span>
                  </div>
                </li>
                <li class="flex items-start gap-2.5 p-3 rounded-md bg-surface-alt border border-border-subtle/60">
                  <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" aria-hidden="true">power</span>
                  <div>
                    <strong class="text-on-surface block">Zona de Prueba en Tienda</strong>
                    <span>Mesas con enchufes para verificar cualquier artículo eléctrico antes de abonar.</span>
                  </div>
                </li>
              </ul>

              <div class="pt-1">
                <a
                  class="w-full inline-flex items-center justify-center gap-2 px-space-md py-3 bg-surface-dark hover:bg-secondary text-on-primary font-label-button text-sm rounded-md transition-colors"
                  href="https://wa.me/34685119511"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span class="material-symbols-outlined text-[18px] text-primary-fixed" aria-hidden="true">chat</span>
                  <span>Consultar por WhatsApp</span>
                </a>
              </div>
            </div>

            <!-- Store Atmosphere Preview Card -->
            <div class="bg-surface-container-lowest p-space-md rounded-lg border border-border-subtle flex items-center gap-space-md">
              <div class="w-24 h-24 rounded-md overflow-hidden shrink-0 bg-surface-container border border-border-subtle/50">
                <img
                  class="w-full h-full object-cover"
                  alt="Pasillo organizado de la tienda outlet Rápido Pack en Alfafar, Valencia"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuDF9qXGJUeSsSOKet9svtf0RfLhCz1GwKHQOBcWjaYORdiKCUwmT9EaGrrYG2qXK1qvW8PctUS13qoTCQbJjk-o9VFuSEJ-s_27duCla7OiO209-2BdzvG-nB3Nf8LRDWuXzVSVDw0FpOZw8c8mSKqVxA0OiUn0-qyMMwF67xYVsAMbvuMBn1z2xdMnUPfIFs28Ct7QqUtVdF02kUOKCPbVR6NTZCRJLSHWtNkEBXf1"
                  loading="lazy"
                  decoding="async"
                  width="96"
                  height="96"
                />
              </div>
              <div class="flex flex-col gap-1 min-w-0">
                <span class="font-label-badge text-xs text-primary uppercase">Transparencia total</span>
                <h4 class="font-headline-sm text-sm text-on-surface font-bold truncate">Comprueba antes de pagar</h4>
                <p class="font-body-sm text-xs text-secondary leading-relaxed">
                  Sin compras a ciegas: revisa el contenido y funcionamiento en el propio local.
                </p>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- 4. Store Locator & Schedule -->
    <StoreLocator
      badge="Acceso y Transporte"
      title="Dónde encontrarnos en Alfafar (Valencia)"
      subtitle="Acceso directo por la autopista V-31 (a 8 minutos de Valencia centro) y aparcamiento libre sin zona azul en la misma calle."
    />

    <!-- 5. Contact FAQ -->
    <section class="w-full bg-surface-container-lowest py-margin-lg border-t border-border-subtle section-deferred">
      <FaqAccordion
        badge="Dudas Frecuentes"
        title="Preguntas rápidas antes de venir"
        subtitle="Resolvemos las consultas más habituales sobre visitas, lotes y servicio de paquetería."
        items={contactFaqs}
        groupName="contact-faq"
      />
    </section>
  </div>
</Layout>
