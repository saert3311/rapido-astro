# Server runtime settings
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Optional build-time public overrides (defaults come from wrangler.json / src/config/site.ts)
# PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# PUBLIC_GTM_ID=GTM-XXXXXXX

# Runtime secrets for POST /api/contact (replace with real values in .env or secret manager)
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
MAILJET_API_KEY=replace-with-mailjet-api-key
MAILJET_SECRET_KEY=replace-with-mailjet-secret-key
MAILJET_FROM_EMAIL=contacto@rapidopackvalencia.es
MAILJET_TO_EMAIL=contacto@rapidopackvalencia.es
MAILJET_CONTACT_LIST_ID=replace-with-mailjet-list-id
